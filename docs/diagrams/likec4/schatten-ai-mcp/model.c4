// Schatten AI via MCP - C4 model (ADR-015)
// Accepted design; implementation pending TASK-069B..TASK-069P.

model {

  user = actor 'Schatten user' {
    #existing
    description 'Admin or consultant. Uses Schatten in the browser. New (ADR-015): chats in their own AI client on their own AI subscription.'
  }

  aiClient = externalSystem 'AI client' {
    #new
    style {
      color green
    }
    description 'User-chosen MCP-capable client. Schatten never calls an LLM and stores no LLM keys.'

    webChat = externalContainer 'claude.ai web chat' {
      #new
      style {
        color green
      }
      technology 'Web app, remote MCP connector'
      description 'Chat in the browser. Its connector calls MCP from the vendor cloud.'
    }
    desktopApp = externalContainer 'Claude Desktop' {
      #new
      style {
        color green
      }
      technology 'Desktop app, custom connector'
      description 'Desktop chat. Custom connectors are brokered by the vendor cloud.'
    }
    localClient = externalContainer 'Claude Code / other local MCP client' {
      #new
      style {
        color green
      }
      technology 'CLI, Streamable HTTP MCP client'
      description 'Calls MCP directly from the workstation. Also used for local development.'
    }
  }

  aiVendor = externalSystem 'AI vendor cloud' {
    #new
    style {
      color green
    }
    description 'The user’s AI vendor, for example Anthropic. Receives business data read through MCP.'

    llm = externalContainer 'LLM inference' {
      #new
      style {
        color green
      }
      description 'Runs the model on the user’s subscription. Decides which MCP tools to call.'
    }
    broker = externalContainer 'Remote connector broker' {
      #new
      style {
        color green
      }
      technology 'OAuth 2.1 public client, MCP client'
      description 'Runs remote connectors for web and desktop chat: OAuth, token storage and MCP calls.'
    }
  }

  entra = externalSystem 'Microsoft Entra ID' {
    #existing
    description 'Existing single-tenant registration. Unchanged by ADR-015.'
  }

  schatten = system 'Schatten' {
    #existing
    description 'Organisation twin modelling, metrics and forecasting. New (ADR-015): OAuth 2.1 authorization server and MCP server for AI clients.'

    spa = webapp 'React SPA' {
      #existing
      technology 'React, TypeScript, Vite'
      description 'Workspace UI. New (ADR-015): consent page /ai/authorize and Metrics tab AI panel for change-set review.'
    }

    caddy = container 'Caddy ingress' {
      #existing
      technology 'Caddy'
      description 'Only public ingress. Serves the SPA and proxies /api. New (ADR-015): also proxies /.well-known/oauth-*; redacts Authorization and pending request ids in logs.'
    }

    backend = container 'Backend API' {
      #existing
      technology 'Python, FastAPI, SQLAlchemy'
      description 'Trusted application layer. Hosts the REST API and session login. New (ADR-015): the OAuth authorization server and both MCP services in the same process.'

      restApi = component 'REST business API' {
        #existing
        technology 'FastAPI /api/v1'
        description 'Existing routers for organisations, scenarios, structure, metrics and predictions.'
      }
      authSession = component 'Session auth and CSRF guard' {
        #existing
        technology 'OIDC RP, opaque sessions'
        description 'Entra login, guarded User linking, SameSite=Strict session, CSRF token and exact Origin.'
      }
      domainServices = component 'Domain services' {
        #existing
        technology 'Python services'
        description 'Organisation States and Twin Structure services. New (ADR-015): flush-only *_in_transaction cores (TASK-069B).'
      }
      oauthServer = component 'MCP OAuth authorization server' {
        #new
        style {
          color green
        }
        technology '/.well-known/oauth-*, /api/oauth/*'
        description 'Discovery, Dynamic Client Registration (allowlist), authorize, token (PKCE S256), refresh rotation, revoke. Opaque hashed tokens.'
      }
      consentApi = component 'Consent and connections API' {
        #new
        style {
          color green
        }
        technology '/api/v1/ai/oauth, /api/v1/ai/connections, /api/v1/ai/users/{user_id}/connections/revoke'
        description 'Approve or deny pending requests; list and revoke own grants; admin revokes all grants of a User. Session + CSRF.'
      }
      mcpAuth = component 'McpBearerAuth and limits' {
        #new
        style {
          color green
        }
        technology 'ASGI middleware'
        description 'Per request: hash token, check grant, resource and User, re-read role, intersect scopes. Rate limit per grant, capacity limiter.'
      }
      mcpRead = component 'MCP read service' {
        #new
        style {
          color green
        }
        technology 'FastMCP, /api/mcp/read, schatten.read'
        description 'Read-only tools, generator preview, change-set inspection and skill prompts.'
      }
      mcpWrite = component 'MCP write service' {
        #new
        style {
          color green
        }
        technology 'FastMCP, /api/mcp/write, schatten.write'
        description 'Stages draft change sets: create, add, validate, submit, discard. With MCP_CHANGE_SET_REVIEW_ENABLED also applies or rejects a submitted change set that the human approves in the client.'
      }
      changeSetEngine = component 'Change-set engine' {
        #new
        style {
          color green
        }
        technology 'Python'
        description 'Resolves $ref, dry-run with rollback, freezes values on submit, atomic apply.'
      }
      reviewApi = component 'Change-set review API' {
        #new
        style {
          color green
        }
        technology '/api/v1/organisations/{org}/ai/change-sets'
        description 'Human list, inspect, apply and reject in the Metrics tab. Session + CSRF.'
      }
      generator = component 'Timeseries generator' {
        #new
        style {
          color green
        }
        technology 'numpy'
        description 'Deterministic, seeded, spec-based values. The LLM chooses parameters, never values.'
      }
      skills = component 'Skills and MCP prompts' {
        #new
        style {
          color green
        }
        technology 'SKILL.md'
        description 'One source for the Claude Code plugin, skill zips (GET /api/v1/ai/skills/{name}.zip) and MCP prompts.'
      }
    }

    worker = container 'Prediction worker' {
      #existing
      technology 'Python, same backend image'
      description 'ADR-012 single worker. Not used or extended by MCP.'
    }

    db = database 'PostgreSQL 18' {
      #existing
      technology 'PostgreSQL'
      description 'Business tables. New (ADR-015): mcp_oauth_* and ai_change_sets*.'
    }
  }

  // People and clients
  user -> schatten.spa 'Uses Schatten, approves consent, reviews change sets' {
    technology 'HTTPS'
  }
  user -> aiClient 'Chats on own AI subscription'
  aiClient.webChat -> aiVendor.llm 'Prompts and tool results'
  aiClient.desktopApp -> aiVendor.llm 'Prompts and tool results'
  aiClient.localClient -> aiVendor.llm 'Prompts and tool results'
  aiClient.webChat -> aiVendor.broker 'Uses remote connector'
  aiClient.desktopApp -> aiVendor.broker 'Uses custom connector'
  aiVendor.broker -> schatten.caddy 'OAuth 2.1 and MCP' {
    technology 'HTTPS, Bearer token'
  }
  aiClient.localClient -> schatten.caddy 'OAuth 2.1 and MCP' {
    technology 'HTTPS, Bearer token'
  }

  // Ingress
  schatten.spa -> schatten.caddy 'Same-origin /api calls' {
    technology 'HTTPS, session cookie'
  }
  schatten.caddy -> schatten.backend.restApi 'Proxies /api/v1'
  schatten.caddy -> schatten.backend.consentApi 'Proxies /api/v1/ai'
  schatten.caddy -> schatten.backend.reviewApi 'Proxies /api/v1/.../ai/change-sets'
  schatten.caddy -> schatten.backend.oauthServer 'Proxies /.well-known/oauth-* and /api/oauth'
  schatten.caddy -> schatten.backend.mcpAuth 'Proxies /api/mcp/read and /api/mcp/write'
  schatten.caddy -> schatten.backend.skills 'Skill zip download (session)'

  // Cookie-session side
  schatten.backend.restApi -> schatten.backend.authSession 'Requires session'
  schatten.backend.consentApi -> schatten.backend.authSession 'Requires session + CSRF'
  schatten.backend.reviewApi -> schatten.backend.authSession 'Requires session + CSRF'
  schatten.backend.skills -> schatten.backend.authSession 'Zip download requires session'
  schatten.backend.authSession -> entra 'OIDC login' {
    technology 'Authorization Code + PKCE'
  }
  schatten.backend.restApi -> schatten.backend.domainServices 'Calls'
  schatten.backend.consentApi -> schatten.backend.oauthServer 'Decides requests, revokes grants'
  schatten.backend.reviewApi -> schatten.backend.changeSetEngine 'Human apply or reject (web)'

  // MCP side
  schatten.backend.mcpAuth -> schatten.backend.oauthServer 'verify_access_token'
  schatten.backend.mcpAuth -> schatten.backend.mcpRead 'Principal with schatten.read'
  schatten.backend.mcpAuth -> schatten.backend.mcpWrite 'Principal with schatten.write'
  schatten.backend.mcpRead -> schatten.backend.domainServices 'Reads through existing services'
  schatten.backend.mcpRead -> schatten.backend.generator 'Preview, persists nothing'
  schatten.backend.mcpRead -> schatten.backend.skills 'Serves prompts'
  schatten.backend.mcpRead -> schatten.backend.changeSetEngine 'Lists and reads change sets and their reviews'
  schatten.backend.mcpWrite -> schatten.backend.changeSetEngine 'Stage, dry-run, submit; apply or reject when enabled (mcp)'
  schatten.backend.changeSetEngine -> schatten.backend.generator 'Freezes values on submit'
  schatten.backend.changeSetEngine -> schatten.backend.domainServices 'Calls *_in_transaction cores'

  // Persistence
  schatten.backend.authSession -> schatten.db 'Users, identities, sessions'
  schatten.backend.oauthServer -> schatten.db 'mcp_oauth_* (hashes only)'
  schatten.backend.changeSetEngine -> schatten.db 'ai_change_sets, ai_change_set_operations'
  schatten.backend.domainServices -> schatten.db 'Business tables'
  schatten.worker -> schatten.db 'Prediction requests and versions (unchanged)'
}
