@startuml
!include <C4/C4_Container>
title Schatten - Accepted ADR-013 Topology (local and production tooling implemented; rollout F pending)

System_Ext(entra, "Microsoft Entra ID", "One tenant; shared confidential Web registration\nShared permissions, consent, assignments and callbacks\nSeparate dev/prod secrets; exact tenant issuer\nopenid profile email; no Graph; email_verified not required")

System_Boundary(local, "Development - https://app.localhost") {
  Person(local_browser, "Local browser")
  Container(app_tls, "Application TLS", "Loopback Caddy :443", "Local CA; secure host-only cookies\nDirect /api routing; HMR WebSockets")
  Container(vite, "Frontend", "Vite :5173", "SPA and HMR")
  Container(local_api, "Local API", "FastAPI :8000", "Direct Entra; development secret\nGuarded pre-provisioned User linking")
  Container(local_worker, "Prediction worker", "Backend runtime", "One worker; database settings only")
  ContainerDb(local_db, "Local database", "PostgreSQL", "Independent development data\nPreserve old identities without issuer rewrites")

  Rel(local_browser, app_tls, "Uses", "HTTPS")
  Rel(app_tls, vite, "SPA / HMR", "HTTP / WebSocket")
  Rel(app_tls, local_api, "/api; fixed headers", "HTTP")
  Rel(local_api, local_db, "Users, identities, sessions")
  Rel(local_worker, local_db, "Queue + advisory lock")
}

System_Boundary(prod, "UpCloud Ubuntu 26.04 LTS - Docker Engine / Compose (runtime G; rollout pending F)") {
  Person(prod_browser, "Production browser")
  Container(caddy, "Frontend and TLS", "Caddy :80 / :443 + React", "https://schatten.lupaus.eu\nPersistent certificate/account storage")
  Container(prod_api, "Production API", "FastAPI :8000", "Direct Entra; production secret\nPrivate; database roles and sessions")
  Container(prod_worker, "Prediction worker", "Same backend image", "One worker; private; database settings only")
  Container(migration, "One-shot migration", "Same backend image", "Success gates API and worker startup")
  Container(ofelia, "Operational scheduler", "Ofelia; pinned digest", "Fixed read-only job file\nNo network or public ports\nDaily backups / weekly cleanup")
  Container(docker_api, "Host control plane", "Docker Engine Unix socket", "Host-administrator-equivalent authority\nSocket :ro does not restrict API writes")
  Container(ops_jobs, "Operational job runners", "Pre-created hardened Compose containers", "Backup: private DB access + required secrets\nWrites /opt/postgres-backups; 7-day retention\nCleanup: protected resources + exclusion locks")
  ContainerDb(prod_db, "Production database", "PostgreSQL 18 container", "Private; persistent volume\nMigration -> reference seed -> admin (explicit C/D commands)\nDaily encrypted on-server backups\n/opt/postgres-backups; host-loss risk\n7-day retention; backup + restore evidence gates")

  Rel(prod_browser, caddy, "Uses", "HTTPS")
  Rel(caddy, prod_api, "/api; fixed headers", "HTTP")
  Rel(prod_api, prod_db, "Users, identities, sessions")
  Rel(prod_worker, prod_db, "Queue + advisory lock")
  Rel(migration, prod_db, "Forward migrations")
  Rel(ofelia, docker_api, "Triggers reviewed jobs", "Local Unix socket")
  Rel(docker_api, ops_jobs, "Executes with verified restrictions")
  Rel(ops_jobs, prod_db, "Backup runner only", "Private database network")
}

Rel(local_api, entra, "Direct OIDC; callback:\nhttps://app.localhost/api/v1/auth/callback", "HTTPS")
Rel(prod_api, entra, "Direct OIDC; callback:\nhttps://schatten.lupaus.eu/api/v1/auth/callback", "HTTPS")

note bottom of app_tls
  Target excludes Authentik in both environments.
  Local Caddy/direct Entra and the production runtime are implemented.
  Browser authorization redirects go directly to Entra.
  Logout returns to /login at each application origin.
end note

note bottom of caddy
  Caddy owns public TLS; no Traefik or Coolify in target.
  Coolify adapter removed; only Caddy publishes 80/443.
  Backend health gates frontend readiness.
  Build on UpCloud; deploy frozen images without rebuild.
  Persistent volumes are not backups.
  Backup tooling (G) and runbook QA (E) done; activation pending F.
end note
@enduml
