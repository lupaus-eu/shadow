// The Yearclock architecture as a C4 model: people, systems, containers, and components.
// Keep in step with docs/architecture/stack.md, docker.md, workers.md, and the ADRs.
model {

  // ── People ────────────────────────────────────────────────────────────────
  organizationAdmin = person 'Owner or Administrator' {
    description 'Runs an Organization: Yearclocks, people, Groups, sharing, billing (Owners), and Support Access approval.'
  }
  organizationMember = person 'Member (Editor or Viewer)' {
    description 'Plans on the Yearclocks they may open: Events, Series, Labels, filters, history.'
  }
  platformOperator = person 'Platform Operator' {
    description 'Platform Admin or Support Agent. Works in the operator console; reaches customer content only through approved Support Access (ADR-0020, ADR-0021).'
  }

  // ── Yearclock ─────────────────────────────────────────────────────────────
  yearclock = softwareSystem 'Yearclock' {
    description 'Multi-tenant SaaS for circular, continuous planning timelines (Yearclocks) owned by Organizations.'

    edge = container 'Edge proxy' {
      technology 'Caddy'
      description 'TLS, security headers, and routing: /api/* to the API, everything else to the web application; Authentik on its own address.'
    }

    webApp = spa 'Web application' {
      technology 'React, TypeScript, Vite, Tailwind CSS, Radix, React Router'
      description 'Single-page application for customers (Organization workspace, Yearclock planner) and the operator console (/platform).'

      authShell = component 'Sign-in and shell' {
        technology 'App.tsx, SignIn, AuthenticatedShell, shell/AppShell, shell/OrganizationSidebar'
        description 'Session check, OIDC sign-in redirect, React Router routes, application shell (sidebar by role, top bar, user menu with language and sign out, mobile drawer).'
      }
      organizationWorkspace = component 'Organization workspace' {
        technology 'OrganizationEntry, admin/*Page, GroupsPanel, BulkInvitations'
        description 'Yearclock overview, People, Invitations, Groups, sharing, access overview, Classification, Seats, Activity, deletion, and the Owner and Admin page for connecting an agent with its switch (ADR-0037).'
      }
      planner = component 'Yearclock planner' {
        technology 'YearclockPlanner, YearclockView (SVG), displays/ (timeline, list, agenda)'
        description 'Circular view and the timeline, list, and agenda displays, Planning Window, Events and Series, filters, search, bulk edit, plan again, Linked Lanes, history, change marks and notice.'
      }
      operatorConsole = component 'Operator console' {
        technology 'PlatformConsole'
        description 'Platform health, Organizations (with the block for agent access), failed jobs, and Support Access requests.'
      }
      apiClients = component 'API clients' {
        technology 'organization-client, auth-client, platform-client'
        description 'Typed fetch wrappers with cookie credentials; map conflicts and limits to errors.'
      }
      localization = component 'Localization' {
        technology 'i18n.ts'
        description 'Finnish and English texts with a parity test (ADR-0016).'
      }
    }

    api = container 'API' {
      technology 'FastAPI, Python, SQLAlchemy 2, Psycopg 3'
      description 'Versioned HTTP API under /api/v1. Every request runs in a transaction with tenant context applied for row-level security.'

      authentication = component 'Authentication and sessions' {
        technology 'auth, auth_routes, oidc'
        description 'OIDC authorization code flow with Authentik, server-side sessions, RP-initiated logout, platform sign-in.'
      }
      organizations = component 'Organizations and memberships' {
        technology 'organization_routes, organization_context_routes, membership_routes, invitation_routes, organization_deletion_routes'
        description 'Signup and activation, workspace context, roles, Invitations (single and bulk), visits, recoverable Organization deletion.'
      }
      billing = component 'Billing and seats' {
        technology 'billing, billing_routes, subscription_routes, seat_capacity, subscription_access'
        description 'Stripe Checkout and portal, webhook projection, seat changes, read-only and grace states (ADR-0009), and the Owner actions to cancel and undo (ADR-0032).'
      }
      legalDocuments = component 'Legal documents' {
        technology 'legal_documents, legal_routes, legal_acceptance, organization_legal_routes'
        description 'Versioned legal texts from backend/legal (ADR-0041) served publicly, Owner acceptances recorded at sign-up and for new versions.'
      }
      accessRule = component 'Access rule' {
        technology 'access, yearclock_reading, yearclock_access_routes, access_overview_routes'
        description 'The single rule for a member\'s role on Yearclocks: Organization role, direct grants, Groups, Organization-wide Access (ADR-0007).'
      }
      groups = component 'Groups' {
        technology 'group_routes'
        description 'Flat Groups of members that receive Yearclock access.'
      }
      structure = component 'Yearclock structure' {
        technology 'yearclock_routes, category_routes'
        description 'Yearclocks, layout, Lanes (own, copied, Linked), Categories, archive and recovery.'
      }
      content = component 'Events and recurrence' {
        technology 'event_routes, event_content, rich_text, series_routes, occurrence_routes, recurrence, series_editing, planning_window'
        description 'Events, Series and Occurrences with rolling materialization (ADR-0025, ADR-0026), bulk edit, plan again, and the content rules for location, links, and formatted descriptions (event_content, rich_text; ADR-0033).'
      }
      classification = component 'Classification and search' {
        technology 'label_routes, event_labels, search_routes'
        description 'Organization Labels and Categories, Label assignment, accent-insensitive search.'
      }
      history = component 'History and awareness' {
        technology 'revisions, history_routes'
        description 'Event Revisions written by session hooks, history, version restore, changes since a time.'
      }
      exchange = component 'Data exchange' {
        technology 'exchange, export_routes, import_routes, organization_export, data_transfer'
        description 'Excel and CSV export and import of a Yearclock\'s Events: formula neutralization, strict all-or-nothing import with a preview, hourly limits counted from the Audit Log, and an audit entry per action (ADR-0030). The Owner-only Organization Export streams a JSON document (organization_export). The Data transfer exports every Organization the user owns or administers as one CSV and imports it back as an update-and-add, previewed in a rolled-back savepoint and saved all or nothing (data_transfer, ADR-0040).'
      }
      notifications = component 'Notifications' {
        technology 'notifications, notification_routes'
        description 'In-app inbox written in the transaction of its cause: effective-role comparison for access changes (access rule), role and invitation notices, per-recipient row-level security, daily cleanup (ADR-0031).'
      }
      mcp = component 'MCP interface' {
        technology 'mcp_server/*, mcp_routes (official Python MCP SDK)'
        description 'Streamable HTTP endpoint at /api/mcp for the person\'s own agents (ADR-0037). Verifies Authentik access tokens (audience = the MCP provider\'s client id, ADR-0038), resolves the customer account, and calls the same functions as the REST API, so the same access rules apply. Read and write tools; each change is audited as made through MCP. Two switches stop it per Organization (Owners and Admins; the operator).'
      }
      support = component 'Support Access and platform' {
        technology 'support_access_routes, platform_routes, platform_admin, monitoring_routes'
        description 'Customer-approved, scoped, audited Support Access; operator console API; health and metrics.'
      }
      audit = component 'Audit log' {
        technology 'audit, audit_routes'
        description 'Append-only Audit Events with minimal change summaries (ADR-0014).'
      }
      persistence = component 'Persistence and tenancy' {
        technology 'database, models, limits, lifecycle'
        description 'Session factory, request context GUCs for RLS (ADR-0012), models, operational ceilings, content lifecycle.'
      }
    }

    worker = container 'Background worker' {
      technology 'Python, same codebase as the API'
      description 'Claims PostgreSQL-backed jobs and outbox messages with row locks and retries with backoff (ADR-0024).'

      scheduler = component 'Scheduler' {
        technology 'worker, jobs'
        description 'Enqueues daily recurrence materialization and content and Organization purge jobs; expires Support Access.'
      }
      jobRunner = component 'Job runner' {
        technology 'jobs, work_queue, recurrence, lifecycle'
        description 'Runs one job in its Organization\'s RLS context; marks failures after five attempts.'
      }
      emailDelivery = component 'Email delivery' {
        technology 'email_delivery, work_queue'
        description 'Delivers queued Invitation email through the outbox.'
      }
    }

    migrate = container 'Migration job' {
      technology 'Alembic'
      description 'One-shot job that upgrades the schema before the API and worker roll out.'
    }

    database = database 'Yearclock database' {
      technology 'PostgreSQL 17'
      description 'Organizations, memberships, Yearclocks and content, Event Revisions, Groups, audit, jobs, and outbox, with row-level security. Schema: docs/architecture/dbml/yearclock.dbml.'
    }
  }

  // ── Identity (self-hosted, separate system) ───────────────────────────────
  authentik = softwareSystem 'Authentik' {
    #selfHosted
    style {
      color secondary
    }
    description 'Self-hosted identity provider: credentials, passkeys, MFA, recovery, identity sessions (ADR-0004, ADR-0010).'

    authentikServer = container 'Authentik server' {
      technology 'Authentik'
      description 'OpenID Connect provider and user interface.'
    }
    authentikWorker = container 'Authentik worker' {
      technology 'Authentik'
      description 'Authentik background tasks and blueprints.'
    }
    authentikDatabase = database 'Authentik database' {
      technology 'PostgreSQL 17 (same server, separate database and owner)'
      description 'Identity data; separate credentials, pools, migrations, and backups (ADR-0011).'
    }
  }

  // ── External systems ──────────────────────────────────────────────────────
  stripe = externalSystem 'Stripe Billing' {
    #external
    description 'Billing system of record: customers, subscriptions, invoices, payment methods.'
  }
  aiAgent = externalSystem 'AI agent (MCP client)' {
    #external
    description 'An agent the person chooses (for example Claude with a custom connector). Yearclock offers the capability and asks nothing itself: confirmations and tool choices belong to the agent and its user (ADR-0037).'
  }
  scaleway = externalSystem 'Scaleway Transactional Email' {
    #external
    description 'Email delivery for Yearclock Invitations and Authentik messages (ADR-0023).'
  }

  // ── Relationships: people ─────────────────────────────────────────────────
  organizationAdmin -> yearclock.webApp 'administers the Organization and plans' 'HTTPS'
  organizationMember -> yearclock.webApp 'plans and reads Yearclocks' 'HTTPS'
  platformOperator -> yearclock.webApp.operatorConsole 'operates the platform' 'HTTPS'
  organizationAdmin -> authentik 'signs in with a passkey or password and MFA' 'HTTPS'
  organizationMember -> authentik 'signs in' 'HTTPS'
  platformOperator -> authentik 'signs in' 'HTTPS'
  organizationMember -> aiAgent 'connects and instructs' 'agent interface'
  aiAgent -> authentik 'signs the person in with a pre-registered client, PKCE, and MFA' 'OAuth 2.0'
  organizationAdmin -> stripe 'pays and manages billing (Checkout, portal)' 'HTTPS'
  scaleway -> organizationMember 'delivers Invitation email' 'SMTP/email'

  // ── Relationships: containers ─────────────────────────────────────────────
  yearclock.edge -> yearclock.webApp 'serves the SPA' 'HTTP'
  yearclock.edge -> yearclock.api 'routes /api/*' 'HTTP'
  yearclock.edge -> authentik.authentikServer 'routes the identity address' 'HTTP'
  yearclock.webApp.apiClients -> yearclock.edge 'calls /api/v1 with the session cookie' 'HTTPS, JSON'
  aiAgent -> yearclock.edge 'calls /api/mcp with a bearer token' 'HTTPS, MCP'
  yearclock.edge -> yearclock.api.mcp 'routes /api/mcp and the protected-resource metadata' 'HTTP'
  yearclock.api.mcp -> authentik.authentikServer 'fetches the signing keys to verify access tokens' 'HTTP, JWKS'
  yearclock.api -> yearclock.database 'reads and writes in RLS-scoped transactions' 'SQL'
  authentik.authentikServer -> yearclock.edge 'sign-in pages import the application\'s stylesheet /theme.css (loaded by the browser)' 'HTTPS'
  yearclock.worker -> yearclock.database 'claims jobs and outbox messages' 'SQL'
  yearclock.migrate -> yearclock.database 'upgrades the schema' 'SQL'
  yearclock.api -> authentik.authentikServer 'exchanges authorization codes, verifies ID tokens' 'OIDC'
  yearclock.api -> stripe 'creates Checkout and portal sessions, changes seats, reads the next charge and invoices' 'HTTPS, REST'
  stripe -[async]-> yearclock.api 'sends signed webhook events' 'HTTPS'
  yearclock.worker.emailDelivery -> scaleway 'sends Invitation email' 'HTTPS/SMTP'
  authentik.authentikServer -> authentik.authentikDatabase 'stores identity data' 'SQL'
  authentik.authentikWorker -> authentik.authentikDatabase 'runs tasks' 'SQL'
  authentik.authentikServer -> scaleway 'sends verification and recovery email' 'SMTP'

  // ── Relationships: web application components ─────────────────────────────
  yearclock.webApp.authShell -> yearclock.webApp.organizationWorkspace 'routes to and frames'
  yearclock.webApp.authShell -> yearclock.webApp.operatorConsole 'opens /platform'
  yearclock.webApp.organizationWorkspace -> yearclock.webApp.planner 'opens a Yearclock page'
  yearclock.webApp.authShell -> yearclock.webApp.apiClients 'checks the session'
  yearclock.webApp.organizationWorkspace -> yearclock.webApp.apiClients 'uses'
  yearclock.webApp.planner -> yearclock.webApp.apiClients 'uses; polls changes every minute'
  yearclock.webApp.operatorConsole -> yearclock.webApp.apiClients 'uses'
  yearclock.webApp.organizationWorkspace -> yearclock.webApp.localization 'reads texts'
  yearclock.webApp.planner -> yearclock.webApp.localization 'reads texts'

  // ── Relationships: API components ─────────────────────────────────────────
  yearclock.webApp -> yearclock.api.authentication 'signs in and out' 'HTTPS'
  yearclock.webApp -> yearclock.api.organizations 'workspace, people, invitations' 'HTTPS'
  yearclock.webApp -> yearclock.api.structure 'Yearclocks, Lanes, Categories' 'HTTPS'
  yearclock.webApp -> yearclock.api.content 'Events and Series' 'HTTPS'
  yearclock.webApp -> yearclock.api.history 'history and changes' 'HTTPS'
  yearclock.webApp -> yearclock.api.exchange 'export, import, Organization Export, and Data transfer' 'HTTPS'
  yearclock.webApp -> yearclock.api.notifications 'inbox and unread count' 'HTTPS'
  yearclock.webApp -> yearclock.api.support 'operator console and Support Access' 'HTTPS'
  yearclock.api.authentication -> authentik 'OIDC code exchange' 'OIDC'
  yearclock.api.billing -> stripe 'Checkout, portal, subscription changes' 'REST'
  stripe -[async]-> yearclock.api.billing 'webhook events' 'HTTPS'
  yearclock.api.organizations -> yearclock.api.billing 'checks seats and read-only state'
  yearclock.api.organizations -> yearclock.api.legalDocuments 'requires accepted documents at signup'
  yearclock.api.organizations -> yearclock.api.groups 'joins Groups on acceptance'
  yearclock.api.structure -> yearclock.api.accessRule 'authorizes'
  yearclock.api.content -> yearclock.api.accessRule 'authorizes, reads Linked Lanes'
  yearclock.api.classification -> yearclock.api.accessRule 'authorizes'
  yearclock.api.history -> yearclock.api.accessRule 'authorizes'
  yearclock.api.groups -> yearclock.api.accessRule 'reports Group access and impact'
  yearclock.api.exchange -> yearclock.api.accessRule 'authorizes, reads Linked Lanes'
  yearclock.api.notifications -> yearclock.api.accessRule 'compares effective roles before and after'
  yearclock.api.groups -> yearclock.api.notifications 'access changes notify'
  yearclock.api.organizations -> yearclock.api.notifications 'role and invitation notices'
  yearclock.api.exchange -> yearclock.api.audit 'records every export and counts the hourly limit'
  yearclock.api.content -> yearclock.api.history 'every change writes a revision (session hooks)'
  yearclock.api.content -> yearclock.api.classification 'assigns Labels'
  yearclock.api.support -> yearclock.api.content 'scoped support reads and writes'
  yearclock.api.organizations -> yearclock.api.audit 'records'
  yearclock.api.structure -> yearclock.api.audit 'records'
  yearclock.api.content -> yearclock.api.audit 'records'
  yearclock.api.support -> yearclock.api.audit 'records every support read and write'
  yearclock.api.organizations -> yearclock.api.persistence 'enqueues Invitation email (outbox)'
  yearclock.api.accessRule -> yearclock.api.persistence 'queries grants'
  yearclock.api.persistence -> yearclock.database 'SQL with request context' 'SQLAlchemy'

  // ── Relationships: worker components ──────────────────────────────────────
  yearclock.worker.scheduler -> yearclock.worker.jobRunner 'enqueues jobs'
  yearclock.worker.scheduler -> yearclock.database 'enqueues and expires grants' 'SQL'
  yearclock.worker.jobRunner -> yearclock.database 'materializes Series, purges content' 'SQL'
  yearclock.worker.emailDelivery -> yearclock.database 'claims outbox messages' 'SQL'
}
