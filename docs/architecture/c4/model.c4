// The Shadow architecture as a C4 model: people, systems, containers, and components.
// Keep in step with docs/architecture/stack.md, docker.md, workers.md, and the ADRs.
model {

  // ── People ────────────────────────────────────────────────────────────────
  organizationAdmin = person 'Owner or Administrator' {
    description 'Runs an Organization: people, Invitations, billing (Owners), agent access, and Support Access approval; also works with models.'
  }
  organizationMember = person 'Member' {
    description 'Works with the models of the Organization: graph, versions, metrics, simulations, and analysis.'
  }
  platformOperator = person 'Platform Operator' {
    description 'Platform Admin or Support Agent. Works in the operator console; reaches customer content only through approved Support Access (ADR-0020, ADR-0021).'
  }

  // ── Shadow ─────────────────────────────────────────────────────────────
  shadow = softwareSystem 'Shadow' {
    description 'Multi-tenant digital-twin SaaS: Organizations own models of themselves as a graph over time, with metrics as time series, forecasts, simulations, and analysis; AI agents connect through MCP.'

    edge = container 'Edge proxy' {
      technology 'Caddy'
      description 'TLS, security headers, and routing: /api/* to the API, everything else to the web application; Authentik on its own address.'
    }

    webApp = spa 'Web application' {
      technology 'React, TypeScript, Vite, Tailwind CSS, Radix, React Router'
      description 'Single-page application for customers (Organization workspace, Model workspace) and the operator console (/platform).'

      authShell = component 'Sign-in and shell' {
        technology 'App.tsx, SignIn, AuthenticatedShell, shell/AppShell, shell/OrganizationSidebar'
        description 'Session check, OIDC sign-in redirect, React Router routes, application shell (sidebar by role, top bar, user menu with language and sign out, mobile drawer).'
      }
      organizationWorkspace = component 'Organization workspace' {
        technology 'OrganizationEntry, admin/*Page, GroupsPanel, BulkInvitations'
        description 'Models list, People, Invitations, Seats, Activity, deletion, and the Owner and Admin page for connecting an agent with its switch (ADR-0037).'
      }
      modelWorkspace = component 'Model workspace' {
        technology 'models/ModelsPage, ModelShell, ModelCanvas, TypesPage, MetricsPage, SimulationsPage, ForecastChart, AnalysisPage'
        description 'Node canvas, Types tab for the metamodel, versions with baseline, change list and merge, metrics with formulas and CSV or Excel import and export, forecasts and simulations, analysis with the optional AI button and Excel export.'
      }
      operatorConsole = component 'Operator console' {
        technology 'PlatformConsole'
        description 'Platform health, Organizations (with the block for agent access), failed jobs, and Support Access requests.'
      }
      apiClients = component 'API clients' {
        technology 'organization-client, auth-client, platform-client'
        description 'Typed fetch wrappers with cookie credentials; map conflicts and limits to errors.'
      }
      localization = component 'Localization' {
        technology 'i18n.ts'
        description 'Finnish and English texts with a parity test (ADR-0016).'
      }
    }

    api = container 'API' {
      technology 'FastAPI, Python, SQLAlchemy 2, Psycopg 3'
      description 'Versioned HTTP API under /api/v1. Every request runs in a transaction with tenant context applied for row-level security.'

      authentication = component 'Authentication and sessions' {
        technology 'auth, auth_routes, oidc'
        description 'OIDC authorization code flow with Authentik, server-side sessions, RP-initiated logout, platform sign-in.'
      }
      organizations = component 'Organizations and memberships' {
        technology 'organization_routes, organization_context_routes, membership_routes, invitation_routes, organization_deletion_routes'
        description 'Signup and activation, workspace context, roles, Invitations (single and bulk), visits, recoverable Organization deletion.'
      }
      billing = component 'Billing and seats' {
        technology 'billing, billing_routes, subscription_routes, seat_capacity, subscription_access'
        description 'Stripe Checkout and portal, webhook projection, seat changes, read-only and grace states (ADR-0009), and the Owner actions to cancel and undo (ADR-0032).'
      }
      legalDocuments = component 'Legal documents' {
        technology 'legal_documents, legal_routes, legal_acceptance, organization_legal_routes'
        description 'Versioned legal texts from backend/legal (ADR-0041) served publicly, Owner acceptances recorded at sign-up and for new versions.'
      }
      accessRule = component 'Access rule' {
        technology 'access'
        description 'Organization roles decide what a person may do: Members read, Editors-by-role (Owner, Admin, Member) write, Owners and Admins manage (ADR-0005, ADR-0007).'
      }
      models = component 'Models, graph and versions' {
        technology 'model_routes, metamodel_routes, version_routes, default_metamodel.json'
        description 'Models with nodes and connections, the per-model metamodel (node types, connection types, allowed connections; ADR-0043), versions with a baseline, change lists and merge into the base (ADR-0045), optimistic concurrency (ADR-0018).'
      }
      timeline = component 'Model timeline' {
        technology 'timeline_routes, timeline_event_routes, timeline/ (state, chain, validate, loader, payloads, compact)'
        description 'Lines (the Base line and Scenarios) hold dated events of changes (ADR-0048). A pure replay engine computes the state after any event; every event write locks the Model row, replays the changed line and every Scenario that branches from it, and refuses a broken chain with a structured 422 (ADR-0049). Reads need membership; Owners and Admins write the Base line, Members write Scenarios.'
      }
      metrics = component 'Metrics and formulas' {
        technology 'metric_routes, metric_engine, formulas'
        description 'Metrics with monthly values per line (Base line or Scenario), derived metrics from formulas evaluated in dependency order.'
      }
      simulations = component 'Forecasts and simulations' {
        technology 'simulation_routes, forecasting'
        description 'Forecast methods linear, seasonal, Holt and Prophet (ADR-0042) with bands, what-if adjustments, and derived metrics.'
      }
      analysis = component 'Analysis' {
        technology 'analysis, analysis_routes'
        description 'Findings and action proposals from rules, plus the summary and proposals an agent writes through MCP (ADR-0047). Calls no model.'
      }
      metricIo = component 'Import and export' {
        technology 'metric_io, metric_io_routes'
        description 'CSV and Excel import of metric values (wide and long layouts) and export of metrics and analyses, with formula-injection-safe cells.'
      }
      notifications = component 'Notifications' {
        technology 'notifications, notification_routes'
        description 'In-app inbox written in the transaction of its cause: effective-role comparison for access changes (access rule), role and invitation notices, per-recipient row-level security, daily cleanup (ADR-0031).'
      }
      mcp = component 'MCP interface' {
        technology 'mcp_server/server, mcp_server/model_tools, mcp_routes (official Python MCP SDK)'
        description 'Streamable HTTP endpoint at /api/mcp for the person\'s own agents (ADR-0037). Verifies Authentik access tokens (audience = the MCP provider\'s client id, ADR-0038), resolves the customer account, and calls the same functions as the REST API, so the same access rules apply. Organization tools plus tools for models, versions, metrics, simulations, analysis, and merging (model_tools; ADR-0046). Read and write tools; each change is audited as made through MCP, and every call is recorded without content for Owners and Admins (ADR-0047). Two switches stop it per Organization (Owners and Admins; the operator).'
      }
      support = component 'Support Access and platform' {
        technology 'support_access_routes, platform_routes, platform_admin, monitoring_routes'
        description 'Customer-approved, scoped, audited Support Access; operator console API; health and metrics.'
      }
      audit = component 'Audit log' {
        technology 'audit, audit_routes'
        description 'Append-only Audit Events with minimal change summaries (ADR-0014).'
      }
      persistence = component 'Persistence and tenancy' {
        technology 'database, models, limits, lifecycle'
        description 'Session factory, request context GUCs for RLS (ADR-0012), models, operational ceilings, content lifecycle.'
      }
    }

    worker = container 'Background worker' {
      technology 'Python, same codebase as the API'
      description 'Claims PostgreSQL-backed jobs and outbox messages with row locks and retries with backoff (ADR-0024).'

      scheduler = component 'Scheduler' {
        technology 'worker, jobs'
        description 'Enqueues daily content and notification cleanup and Organization purge jobs; expires Support Access.'
      }
      jobRunner = component 'Job runner' {
        technology 'jobs, work_queue, lifecycle'
        description 'Runs one job in its Organization\'s RLS context; marks failures after five attempts.'
      }
      emailDelivery = component 'Email delivery' {
        technology 'email_delivery, work_queue'
        description 'Delivers queued Invitation email through the outbox.'
      }
    }

    migrate = container 'Migration job' {
      technology 'Alembic'
      description 'One-shot job that upgrades the schema before the API and worker roll out.'
    }

    database = database 'Shadow database' {
      technology 'PostgreSQL 17'
      description 'Organizations, memberships, models with nodes, connections, types and versions, metrics and values, simulations and recommendations, audit, jobs, and outbox, with row-level security. Schema: docs/architecture/dbml/shadow.dbml.'
    }
  }

  // ── Identity (self-hosted, separate system) ───────────────────────────────
  authentik = softwareSystem 'Authentik' {
    #selfHosted
    style {
      color secondary
    }
    description 'Self-hosted identity provider: credentials, passkeys, MFA, recovery, identity sessions (ADR-0004, ADR-0010).'

    authentikServer = container 'Authentik server' {
      technology 'Authentik'
      description 'OpenID Connect provider and user interface.'
    }
    authentikWorker = container 'Authentik worker' {
      technology 'Authentik'
      description 'Authentik background tasks and blueprints.'
    }
    authentikDatabase = database 'Authentik database' {
      technology 'PostgreSQL 17 (same server, separate database and owner)'
      description 'Identity data; separate credentials, pools, migrations, and backups (ADR-0011).'
    }
  }

  // ── External systems ──────────────────────────────────────────────────────
  stripe = externalSystem 'Stripe Billing' {
    #external
    description 'Billing system of record: customers, subscriptions, invoices, payment methods.'
  }
  aiAgent = externalSystem 'AI agent (MCP client)' {
    #external
    description 'An agent the person chooses (for example Claude with a custom connector). Shadow offers the capability and asks nothing itself: confirmations and tool choices belong to the agent and its user (ADR-0037).'
  }
  scaleway = externalSystem 'Scaleway Transactional Email' {
    #external
    description 'Email delivery for Shadow Invitations and Authentik messages (ADR-0023).'
  }

  // ── Relationships: people ─────────────────────────────────────────────────
  organizationAdmin -> shadow.webApp 'administers the Organization and works with models' 'HTTPS'
  organizationMember -> shadow.webApp 'works with models' 'HTTPS'
  platformOperator -> shadow.webApp.operatorConsole 'operates the platform' 'HTTPS'
  organizationAdmin -> authentik 'signs in with a passkey or password and MFA' 'HTTPS'
  organizationMember -> authentik 'signs in' 'HTTPS'
  platformOperator -> authentik 'signs in' 'HTTPS'
  organizationMember -> aiAgent 'connects and instructs' 'agent interface'
  aiAgent -> authentik 'signs the person in with a pre-registered client, PKCE, and MFA' 'OAuth 2.0'
  organizationAdmin -> stripe 'pays and manages billing (Checkout, portal)' 'HTTPS'
  scaleway -> organizationMember 'delivers Invitation email' 'SMTP/email'

  // ── Relationships: containers ─────────────────────────────────────────────
  shadow.edge -> shadow.webApp 'serves the SPA' 'HTTP'
  shadow.edge -> shadow.api 'routes /api/*' 'HTTP'
  shadow.edge -> authentik.authentikServer 'routes the identity address' 'HTTP'
  shadow.webApp.apiClients -> shadow.edge 'calls /api/v1 with the session cookie' 'HTTPS, JSON'
  aiAgent -> shadow.edge 'calls /api/mcp with a bearer token' 'HTTPS, MCP'
  shadow.edge -> shadow.api.mcp 'routes /api/mcp and the protected-resource metadata' 'HTTP'
  shadow.api.mcp -> authentik.authentikServer 'fetches the signing keys to verify access tokens' 'HTTP, JWKS'
  shadow.api -> shadow.database 'reads and writes in RLS-scoped transactions' 'SQL'
  authentik.authentikServer -> shadow.edge 'sign-in pages import the application\'s stylesheet /theme.css (loaded by the browser)' 'HTTPS'
  shadow.worker -> shadow.database 'claims jobs and outbox messages' 'SQL'
  shadow.migrate -> shadow.database 'upgrades the schema' 'SQL'
  shadow.api -> authentik.authentikServer 'exchanges authorization codes, verifies ID tokens' 'OIDC'
  shadow.api -> stripe 'creates Checkout and portal sessions, changes seats, reads the next charge and invoices' 'HTTPS, REST'
  stripe -[async]-> shadow.api 'sends signed webhook events' 'HTTPS'
  shadow.worker.emailDelivery -> scaleway 'sends Invitation email' 'HTTPS/SMTP'
  authentik.authentikServer -> authentik.authentikDatabase 'stores identity data' 'SQL'
  authentik.authentikWorker -> authentik.authentikDatabase 'runs tasks' 'SQL'
  authentik.authentikServer -> scaleway 'sends verification and recovery email' 'SMTP'

  // ── Relationships: web application components ─────────────────────────────
  shadow.webApp.authShell -> shadow.webApp.organizationWorkspace 'routes to and frames'
  shadow.webApp.authShell -> shadow.webApp.operatorConsole 'opens /platform'
  shadow.webApp.organizationWorkspace -> shadow.webApp.modelWorkspace 'opens a model page'
  shadow.webApp.authShell -> shadow.webApp.apiClients 'checks the session'
  shadow.webApp.organizationWorkspace -> shadow.webApp.apiClients 'uses'
  shadow.webApp.modelWorkspace -> shadow.webApp.apiClients 'uses'
  shadow.webApp.operatorConsole -> shadow.webApp.apiClients 'uses'
  shadow.webApp.organizationWorkspace -> shadow.webApp.localization 'reads texts'
  shadow.webApp.modelWorkspace -> shadow.webApp.localization 'reads texts'

  // ── Relationships: API components ─────────────────────────────────────────
  shadow.webApp -> shadow.api.authentication 'signs in and out' 'HTTPS'
  shadow.webApp -> shadow.api.organizations 'workspace, people, invitations' 'HTTPS'
  shadow.webApp -> shadow.api.notifications 'inbox and unread count' 'HTTPS'
  shadow.webApp -> shadow.api.support 'operator console and Support Access' 'HTTPS'
  shadow.api.authentication -> authentik 'OIDC code exchange' 'OIDC'
  shadow.api.billing -> stripe 'Checkout, portal, subscription changes' 'REST'
  stripe -[async]-> shadow.api.billing 'webhook events' 'HTTPS'
  shadow.api.organizations -> shadow.api.billing 'checks seats and read-only state'
  shadow.api.organizations -> shadow.api.legalDocuments 'requires accepted documents at signup'
  shadow.api.organizations -> shadow.api.notifications 'role and invitation notices'
  shadow.webApp -> shadow.api.models 'models, graph, metamodel, versions' 'HTTPS'
  shadow.webApp -> shadow.api.timeline 'lines, events and states' 'HTTPS'
  shadow.webApp -> shadow.api.metrics 'metrics and values' 'HTTPS'
  shadow.webApp -> shadow.api.simulations 'forecasts and simulations' 'HTTPS'
  shadow.webApp -> shadow.api.analysis 'analysis and proposals' 'HTTPS'
  shadow.webApp -> shadow.api.metricIo 'import and export' 'HTTPS'
  shadow.api.models -> shadow.api.accessRule 'authorizes'
  shadow.api.timeline -> shadow.api.accessRule 'authorizes (Base line: Owner or Admin)'
  shadow.api.timeline -> shadow.api.models 'reads the metamodel and Model row, locks the Model for each write'
  shadow.api.metrics -> shadow.api.accessRule 'authorizes'
  shadow.api.simulations -> shadow.api.accessRule 'authorizes'
  shadow.api.analysis -> shadow.api.accessRule 'authorizes'
  shadow.api.metricIo -> shadow.api.accessRule 'authorizes'
  shadow.api.simulations -> shadow.api.metrics 'reads history, evaluates derived metrics'
  shadow.api.analysis -> shadow.api.simulations 'reads forecasts and findings inputs'
  shadow.api.metricIo -> shadow.api.metrics 'writes imported values, reads series'
  shadow.api.mcp -> shadow.api.models 'calls the same functions'
  shadow.api.mcp -> shadow.api.timeline 'calls the same functions'
  shadow.api.mcp -> shadow.api.metrics 'calls the same functions'
  shadow.api.mcp -> shadow.api.simulations 'calls the same functions'
  shadow.api.mcp -> shadow.api.analysis 'calls the same functions, including the agents summary and proposals'
  shadow.api.mcp -> shadow.api.persistence 'records every call without content (mcp_calls)'
  shadow.api.models -> shadow.api.audit 'records'
  shadow.api.timeline -> shadow.api.audit 'records event.created, event.updated and event.deleted without names'
  shadow.api.metrics -> shadow.api.audit 'records'
  shadow.api.simulations -> shadow.api.audit 'records'
  shadow.api.analysis -> shadow.api.audit 'records'
  shadow.api.organizations -> shadow.api.audit 'records'
  shadow.api.support -> shadow.api.audit 'records every support read and write'
  shadow.api.organizations -> shadow.api.persistence 'enqueues Invitation email (outbox)'
  shadow.api.persistence -> shadow.database 'SQL with request context' 'SQLAlchemy'

  // ── Relationships: worker components ──────────────────────────────────────
  shadow.worker.scheduler -> shadow.worker.jobRunner 'enqueues jobs'
  shadow.worker.scheduler -> shadow.database 'enqueues and expires grants' 'SQL'
  shadow.worker.jobRunner -> shadow.database 'purges expired data' 'SQL'
  shadow.worker.emailDelivery -> shadow.database 'claims outbox messages' 'SQL'
}
