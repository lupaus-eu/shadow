// C4 views: system context (level 1), containers (level 2), components (level 3),
// dynamic views for key flows, and deployment views.
views {

  view index {
    title '1 · System context'
    description 'Yearclock, its users, and the systems it depends on.'
    include
      organizationAdmin,
      organizationMember,
      platformOperator,
      yearclock,
      authentik,
      stripe,
      scaleway,
      aiAgent
    autoLayout TopBottom
  }

  view containers of yearclock {
    title '2 · Containers'
    description 'The deployable parts of Yearclock and their connections.'
    include
      *,
      organizationAdmin,
      organizationMember,
      platformOperator,
      authentik,
      stripe,
      scaleway,
      aiAgent
    autoLayout TopBottom
  }

  view identity of authentik {
    title '2 · Containers: Authentik'
    description 'The self-hosted identity system alongside Yearclock.'
    include *, yearclock.api, yearclock.edge, scaleway
    autoLayout LeftRight
  }

  view webAppComponents of yearclock.webApp {
    title '3 · Components: web application'
    include *
    autoLayout TopBottom
  }

  view apiComponents of yearclock.api {
    title '3 · Components: API'
    description 'Every Yearclock access check goes through the Access rule component.'
    include *
    exclude yearclock.webApp -> yearclock.api.*
    include yearclock.webApp
    autoLayout TopBottom
  }

  view workerComponents of yearclock.worker {
    title '3 · Components: background worker'
    include *
    autoLayout LeftRight
  }

  dynamic view signIn {
    title 'Flow · Sign in'
    description 'OIDC authorization code flow; Authentik enforces passkeys or MFA (ADR-0004).'
    organizationMember -> yearclock.webApp 'opens Yearclock'
    yearclock.webApp -> yearclock.api.authentication 'starts sign-in'
    organizationMember -> authentik 'authenticates with a passkey or password and MFA'
    yearclock.webApp -> yearclock.api.authentication 'returns with the authorization code'
    yearclock.api.authentication -> authentik 'exchanges the code, verifies the ID token'
    yearclock.api.authentication -> yearclock.api.persistence 'creates the server-side session'
    autoLayout LeftRight
  }

  dynamic view invitation {
    title 'Flow · Invite and join'
    organizationAdmin -> yearclock.webApp 'invites people (single or bulk, with Groups)'
    yearclock.webApp -> yearclock.api.organizations 'POST invitations'
    yearclock.api.organizations -> yearclock.api.billing 'checks seats'
    yearclock.api.organizations -> yearclock.api.persistence 'stores the Invitation and outbox message'
    yearclock.worker.emailDelivery -> yearclock.database 'claims the outbox message'
    yearclock.worker.emailDelivery -> scaleway 'sends the email'
    scaleway -> organizationMember 'delivers the Invitation'
    organizationMember -> yearclock.webApp 'accepts after signing in'
    yearclock.api.organizations -> yearclock.api.groups 'joins the chosen Groups'
    autoLayout LeftRight
  }

  dynamic view billingWebhook {
    title 'Flow · Subscription change'
    organizationAdmin -> stripe 'changes the plan or pays'
    stripe -> yearclock.api.billing 'sends a signed webhook'
    yearclock.api.billing -> yearclock.api.persistence 'projects subscription state and seats'
    yearclock.api.billing -> yearclock.api.audit 'records the change'
    autoLayout LeftRight
  }

  dynamic view eventChange {
    title 'Flow · Change an Event'
    organizationMember -> yearclock.webApp.planner 'edits an Event'
    yearclock.webApp.planner -> yearclock.webApp.apiClients 'PATCH with expected_version'
    yearclock.webApp.apiClients -> yearclock.api.content 'updates the Event'
    yearclock.api.content -> yearclock.api.accessRule 'checks Editor access'
    yearclock.api.content -> yearclock.api.history 'writes an Event Revision'
    yearclock.api.content -> yearclock.api.audit 'records event.updated'
    yearclock.webApp.planner -> yearclock.webApp.apiClients 'other viewers poll changes and see a notice'
    autoLayout LeftRight
  }

  deployment view localDeployment {
    title 'Deployment · Local Docker Compose'
    include local.**
    autoLayout LeftRight
  }

  deployment view productionDeployment {
    title 'Deployment · Production'
    include production.**
    autoLayout LeftRight
  }
}
