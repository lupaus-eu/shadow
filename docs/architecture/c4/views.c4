// C4 views: system context (level 1), containers (level 2), components (level 3),
// dynamic views for key flows, and deployment views.
views {

  view index {
    title '1 · System context'
    description 'Shadow, its users, and the systems it depends on.'
    include
      organizationAdmin,
      organizationMember,
      platformOperator,
      shadow,
      authentik,
      stripe,
      scaleway,
      aiAgent
    autoLayout TopBottom
  }

  view containers of shadow {
    title '2 · Containers'
    description 'The deployable parts of Shadow and their connections.'
    include
      *,
      organizationAdmin,
      organizationMember,
      platformOperator,
      authentik,
      stripe,
      scaleway,
      aiAgent
    autoLayout TopBottom
  }

  view identity of authentik {
    title '2 · Containers: Authentik'
    description 'The self-hosted identity system alongside Shadow.'
    include *, shadow.api, shadow.edge, scaleway
    autoLayout LeftRight
  }

  view webAppComponents of shadow.webApp {
    title '3 · Components: web application'
    include *
    autoLayout TopBottom
  }

  view apiComponents of shadow.api {
    title '3 · Components: API'
    description 'Every feature component authorizes through the Access rule component.'
    include *
    exclude shadow.webApp -> shadow.api.*
    include shadow.webApp
    autoLayout TopBottom
  }

  view workerComponents of shadow.worker {
    title '3 · Components: background worker'
    include *
    autoLayout LeftRight
  }

  dynamic view signIn {
    title 'Flow · Sign in'
    description 'OIDC authorization code flow; Authentik enforces passkeys or MFA (ADR-0004).'
    organizationMember -> shadow.webApp 'opens Shadow'
    shadow.webApp -> shadow.api.authentication 'starts sign-in'
    organizationMember -> authentik 'authenticates with a passkey or password and MFA'
    shadow.webApp -> shadow.api.authentication 'returns with the authorization code'
    shadow.api.authentication -> authentik 'exchanges the code, verifies the ID token'
    shadow.api.authentication -> shadow.api.persistence 'creates the server-side session'
    autoLayout LeftRight
  }

  dynamic view invitation {
    title 'Flow · Invite and join'
    organizationAdmin -> shadow.webApp 'invites people (single or bulk)'
    shadow.webApp -> shadow.api.organizations 'POST invitations'
    shadow.api.organizations -> shadow.api.billing 'checks seats'
    shadow.api.organizations -> shadow.api.persistence 'stores the Invitation and outbox message'
    shadow.worker.emailDelivery -> shadow.database 'claims the outbox message'
    shadow.worker.emailDelivery -> scaleway 'sends the email'
    scaleway -> organizationMember 'delivers the Invitation'
    organizationMember -> shadow.webApp 'accepts after signing in'
    autoLayout LeftRight
  }

  dynamic view billingWebhook {
    title 'Flow · Subscription change'
    organizationAdmin -> stripe 'changes the plan or pays'
    stripe -> shadow.api.billing 'sends a signed webhook'
    shadow.api.billing -> shadow.api.persistence 'projects subscription state and seats'
    shadow.api.billing -> shadow.api.audit 'records the change'
    autoLayout LeftRight
  }

  dynamic view versionMerge {
    title 'Flow · Merge a version into its base'
    organizationAdmin -> shadow.webApp.modelWorkspace 'confirms Merge into base'
    shadow.webApp.modelWorkspace -> shadow.webApp.apiClients 'POST merge with expected_version'
    shadow.webApp.apiClients -> shadow.api.models 'applies the change list to the base'
    shadow.api.models -> shadow.api.accessRule 'requires Owner or Admin'
    shadow.api.models -> shadow.api.audit 'records version.merged'
    autoLayout LeftRight
  }

  dynamic view agentAnalysis {
    title 'Flow · An agent analyses a simulation'
    organizationMember -> aiAgent 'asks it to analyse a simulation'
    aiAgent -> shadow.api.mcp 'get_analysis, then set_analysis_summary and add_proposal'
    shadow.api.mcp -> shadow.api.analysis 'same functions as the web application'
    shadow.api.analysis -> shadow.api.persistence 'stores summary and proposals with the agent as author'
    shadow.api.mcp -> shadow.api.persistence 'records the call without content'
    autoLayout LeftRight
  }

  deployment view localDeployment {
    title 'Deployment · Local Docker Compose'
    include local.**
    autoLayout LeftRight
  }

  deployment view productionDeployment {
    title 'Deployment · Production'
    include production.**
    autoLayout LeftRight
  }
}
