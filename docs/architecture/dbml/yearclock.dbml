Table user_accounts {
  id uuid [pk]
  oidc_issuer varchar(500) [not null]
  oidc_subject varchar(255) [not null]
  account_class varchar(20) [not null]
  email varchar(320) [not null]
  display_name varchar(200) [not null]
  locale varchar(2) [not null, default: `'en'::character varying`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (oidc_issuer, oidc_subject) [unique]
  }

  Note: 'Checks: ck_user_accounts_account_class: account_class::text = ANY (ARRAY[\'customer\'::character varying, \'platform\'::character varying]::text[]); ck_user_accounts_locale: locale::text = ANY (ARRAY[\'en\'::character varying, \'fi\'::character varying]::text[])'
}

Table user_sessions {
  id uuid [pk]
  user_account_id uuid [not null]
  token_hash varchar(64) [not null, unique]
  expires_at "timestamp with time zone" [not null]
  revoked_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
  id_token_hint text

  indexes {
    expires_at [name: 'ix_user_sessions_expires_at']
    user_account_id [name: 'ix_user_sessions_user_account_id']
  }
}

Table yearclock_access_grants {
  id uuid [pk]
  organization_id uuid [not null]
  yearclock_id uuid [not null]
  user_account_id uuid [not null]
  role varchar(20) [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  version integer [not null, default: `1`]

  indexes {
    (yearclock_id, user_account_id) [unique]
    organization_id [name: 'ix_yearclock_access_grants_organization_id']
    yearclock_id [name: 'ix_yearclock_access_grants_yearclock_id']
  }

  Note: 'Checks: ck_yearclock_access_grants_role: role::text = ANY (ARRAY[\'editor\'::character varying, \'viewer\'::character varying]::text[]). RLS forced: yearclock_access_grants_live_organization (restrictive) all, yearclock_access_grants_policy all, yearclock_access_grants_support_delete (restrictive) delete, yearclock_access_grants_support_insert (restrictive) insert, yearclock_access_grants_support_select (restrictive) select, yearclock_access_grants_support_update (restrictive) update'
}

Table yearclock_group_grants {
  id uuid [pk]
  organization_id uuid [not null]
  yearclock_id uuid [not null]
  group_id uuid [not null]
  role varchar(10) [not null]
  version integer [not null, default: `1`]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (yearclock_id, group_id) [unique]
    group_id [name: 'ix_yearclock_group_grants_group_id']
    yearclock_id [name: 'ix_yearclock_group_grants_yearclock_id']
  }

  Note: 'Checks: ck_yearclock_group_grants_role: role::text = ANY (ARRAY[\'editor\'::character varying, \'viewer\'::character varying]::text[]). RLS forced: yearclock_group_grants_live_organization (restrictive) all, yearclock_group_grants_no_support (restrictive) all, yearclock_group_grants_policy all'
}

Table yearclock_visits {
  membership_id uuid
  yearclock_id uuid
  organization_id uuid [not null]
  user_account_id uuid [not null]
  visited_at "timestamp with time zone" [not null, default: `now()`]
  previous_visited_at "timestamp with time zone"

  indexes {
    (membership_id, yearclock_id) [pk]
    (organization_id, user_account_id, visited_at) [name: 'ix_yearclock_visits_user_recent']
  }

  Note: 'RLS forced: yearclock_visits_live_organization (restrictive) all, yearclock_visits_own all'
}

Table yearclocks {
  id uuid [pk]
  organization_id uuid [not null]
  name varchar(200) [not null]
  display_order integer [not null, default: `0`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  version integer [not null, default: `1`]
  archived_at "timestamp with time zone"
  deleted_at "timestamp with time zone"
  start_month smallint [not null, default: `'1'::smallint`]
  show_week_ring boolean [not null, default: `false`]
  show_quarter_ring boolean [not null, default: `false`]
  organization_access varchar(10) [not null, default: `'none'::character varying`]

  indexes {
    (organization_id, id) [unique]
    deleted_at [name: 'ix_yearclocks_deleted_at']
    organization_id [name: 'ix_yearclocks_organization_id']
  }

  Note: 'Checks: ck_yearclocks_organization_access: organization_access::text = ANY (ARRAY[\'none\'::character varying, \'viewer\'::character varying, \'editor\'::character varying]::text[]); ck_yearclocks_start_month: start_month >= 1 AND start_month <= 12. RLS forced: yearclocks_delete delete, yearclocks_insert insert, yearclocks_live_organization (restrictive) all, yearclocks_select select, yearclocks_support_delete (restrictive) delete, yearclocks_support_insert (restrictive) insert, yearclocks_support_select (restrictive) select, yearclocks_support_update (restrictive) update, yearclocks_update update'
}

