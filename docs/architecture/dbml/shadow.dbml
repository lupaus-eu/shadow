TableGroup identity {
  user_accounts
  user_sessions
  oidc_login_attempts
  platform_roles
  platform_enrollments
}

TableGroup organization {
  organizations
  organization_memberships
  organization_invitations
}

TableGroup billing {
  organization_seat_changes
  organization_seat_previews
  stripe_webhook_events
}

TableGroup legal {
  legal_acceptances
  legal_announcements
}

TableGroup model_graph {
  models
  model_versions
  nodes
  connections
}

TableGroup model_timeline {
  model_lines
  timeline_events
  event_changes
  node_positions
}

TableGroup metamodel {
  node_types
  connection_types
  allowed_connections
}

TableGroup metrics {
  metrics
  metric_values
}

TableGroup simulation_analysis {
  simulations
  simulation_points
