  roles "varchar(30)[]" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  expires_at "timestamp with time zone" [not null]
  consumed_at "timestamp with time zone"
  user_account_id uuid

  indexes {
    email [name: 'ix_platform_enrollments_email']
  }

  Note: 'Checks: ck_platform_enrollments_roles: roles <@ ARRAY[\'platform_admin\'::character varying, \'support_agent\'::character varying] AND cardinality(roles) > 0'
}

Table platform_roles {
  id uuid [pk]
  user_account_id uuid [not null]
  role varchar(30) [not null]

  indexes {
    (user_account_id, role) [unique]
  }

  Note: 'Checks: ck_platform_roles_role: role::text = ANY (ARRAY[\'platform_admin\'::character varying, \'support_agent\'::character varying]::text[])'
}

Table recommendations {
  id uuid [pk]
  organization_id uuid [not null]
  simulation_id uuid [not null]
  kind varchar(30) [not null]
  severity varchar(10) [not null]
  metric_key varchar(40) [not null]
  title varchar(200) [not null]
  rationale text [not null]
  status varchar(12) [not null, default: `'proposed'::character varying`]
  version integer [not null, default: `1`]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (simulation_id, kind, metric_key) [unique]
    organization_id [name: 'ix_recommendations_organization_id']
    simulation_id [name: 'ix_recommendations_simulation_id']
  }

  Note: 'Checks: ck_recommendations_severity: severity::text = ANY (ARRAY[\'high\'::character varying, \'medium\'::character varying, \'low\'::character varying]::text[]); ck_recommendations_status: status::text = ANY (ARRAY[\'proposed\'::character varying, \'accepted\'::character varying, \'dismissed\'::character varying]::text[]). RLS forced: recommendations_live_organization (restrictive) all, recommendations_policy all, recommendations_support_delete (restrictive) delete, recommendations_support_insert (restrictive) insert, recommendations_support_select (restrictive) select, recommendations_support_update (restrictive) update'
}

Table simulation_points {
  simulation_id uuid
  metric_key varchar(40)
  period date
  organization_id uuid [not null]
  value "double precision" [not null]
  lower "double precision"
  upper "double precision"

  indexes {
    (metric_key, period, simulation_id) [pk]
    organization_id [name: 'ix_simulation_points_organization_id']
  }

  Note: 'RLS forced: simulation_points_live_organization (restrictive) all, simulation_points_policy all, simulation_points_support_delete (restrictive) delete, simulation_points_support_insert (restrictive) insert, simulation_points_support_select (restrictive) select, simulation_points_support_update (restrictive) update'
}

Table simulations {
  id uuid [pk]
  organization_id uuid [not null]
  model_id uuid [not null]
  version_id uuid [not null]
  name varchar(120) [not null]
  method varchar(20) [not null]
  horizon_months integer [not null]
  adjustments jsonb [not null, default: `'[]'::jsonb`]
  skipped jsonb [not null, default: `'{}'::jsonb`]
  history_end date
  created_by_user_account_id uuid
  created_at "timestamp with time zone" [not null, default: `now()`]
  analysis_summary text
  analysis_summary_at "timestamp with time zone"
  analysis_summary_author text
  line_id uuid

  indexes {
    (id, organization_id) [unique]
    line_id [name: 'ix_simulations_line_id']
    model_id [name: 'ix_simulations_model_id']
    organization_id [name: 'ix_simulations_organization_id']
    version_id [name: 'ix_simulations_version_id']
  }

  Note: 'Checks: ck_simulations_horizon: horizon_months >= 1 AND horizon_months <= 60; ck_simulations_method: method::text = ANY (ARRAY[\'linear\'::character varying, \'seasonal\'::character varying, \'holt\'::character varying, \'prophet\'::character varying]::text[]); ck_simulations_name: length(btrim(name::text)) > 0. RLS forced: simulations_live_organization (restrictive) all, simulations_policy all, simulations_support_delete (restrictive) delete, simulations_support_insert (restrictive) insert, simulations_support_select (restrictive) select, simulations_support_update (restrictive) update'
}

Table stripe_webhook_events {
  event_id varchar(255) [pk]
  organization_id uuid
  event_type varchar(120) [not null]
  outcome varchar(40) [not null]
  processed_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    organization_id [name: 'ix_stripe_webhook_events_organization_id']
  }
}

Table support_access_requests {
  id uuid [pk]
  organization_id uuid [not null]
  requested_by_user_account_id uuid [not null]
  case_reference varchar(200) [not null]
  scope varchar(20) [not null]
  status varchar(20) [not null]
  expires_at "timestamp with time zone"
  approved_by_user_account_id uuid
  requested_hours integer [not null, default: `1`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  decided_at "timestamp with time zone"
  revoked_at "timestamp with time zone"

  Note: 'Checks: ck_support_access_hours: requested_hours >= 1 AND requested_hours <= 24; ck_support_access_scope: scope::text = ANY (ARRAY[\'read\'::character varying, \'write\'::character varying]::text[]); ck_support_access_status: status::text = ANY (ARRAY[\'pending\'::character varying, \'approved\'::character varying, \'rejected\'::character varying, \'revoked\'::character varying, \'expired\'::character varying]::text[]). RLS forced: support_access_requests_insert insert, support_access_requests_purge delete, support_access_requests_select select, support_access_requests_update update'
}

Table timeline_events {
  id uuid [pk]
  organization_id uuid [not null]
  model_id uuid [not null]
  line_id uuid [not null]
  occurred_on date [not null]
  seq bigint [not null]
  title varchar(200) [not null]
  note text
  version integer [not null, default: `1`]
  created_by_user_account_id uuid
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (id, line_id) [unique]
    (line_id, occurred_on, seq) [name: 'ix_timeline_events_line_order']
    model_id [name: 'ix_timeline_events_model_id']
    organization_id [name: 'ix_timeline_events_organization_id']
  }

  Note: 'Checks: ck_timeline_events_title: length(btrim(title::text)) > 0. RLS forced: timeline_events_live_organization (restrictive) all, timeline_events_policy all, timeline_events_support_delete (restrictive) delete, timeline_events_support_insert (restrictive) insert, timeline_events_support_select (restrictive) select, timeline_events_support_update (restrictive) update'
}

Table user_accounts {
  id uuid [pk]
  oidc_issuer varchar(500) [not null]
  oidc_subject varchar(255) [not null]
  account_class varchar(20) [not null]
  email varchar(320) [not null]
  display_name varchar(200) [not null]
  locale varchar(2) [not null, default: `'en'::character varying`]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (oidc_issuer, oidc_subject) [unique]
  }

  Note: 'Checks: ck_user_accounts_account_class: account_class::text = ANY (ARRAY[\'customer\'::character varying, \'platform\'::character varying]::text[]); ck_user_accounts_locale: locale::text = ANY (ARRAY[\'en\'::character varying, \'fi\'::character varying]::text[])'
}

Table user_sessions {
  id uuid [pk]
  user_account_id uuid [not null]
  token_hash varchar(64) [not null, unique]
  expires_at "timestamp with time zone" [not null]
  revoked_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]
  id_token_hint text

  indexes {
    expires_at [name: 'ix_user_sessions_expires_at']
    user_account_id [name: 'ix_user_sessions_user_account_id']
  }
}

