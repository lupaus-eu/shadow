// Shadow AI via MCP - C4 model (ADR-015)
// Implemented by TASK-069B..TASK-069P; MCP is enabled in production since
// 2026-11-03 after its separate approval. TASK-074 (ADR-015 amendment of
// 2026-11-03) replaces the read and write services with one MCP service.

model {

  user = actor 'Shadow user' {
    #existing
    description 'Admin or consultant. Uses Shadow in the browser. Since ADR-015: chats in their own AI client on their own AI subscription.'
  }

  aiClient = externalSystem 'AI client' {
    #existing
    description 'User-chosen MCP-capable client. Shadow never calls an LLM and stores no LLM keys.'

    webChat = externalContainer 'claude.ai web chat' {
      #existing
      technology 'Web app, remote MCP connector'
      description 'Chat in the browser. Its connector calls MCP from the vendor cloud.'
    }
    desktopApp = externalContainer 'Claude Desktop' {
      #existing
      technology 'Desktop app, custom connector'
      description 'Desktop chat. Custom connectors are brokered by the vendor cloud.'
    }
    localClient = externalContainer 'Claude Code / other local MCP client' {
      #existing
      technology 'CLI, Streamable HTTP MCP client'
      description 'Calls MCP directly from the workstation. Also used for local development.'
    }
  }

  aiVendor = externalSystem 'AI vendor cloud' {
    #existing
    description 'The user’s AI vendor, for example Anthropic. Receives business data read through MCP.'

    llm = externalContainer 'LLM inference' {
      #existing
      description 'Runs the model on the user’s subscription. Decides which MCP tools to call.'
    }
    broker = externalContainer 'Remote connector broker' {
      #existing
      technology 'OAuth 2.1 public client, MCP client'
      description 'Runs remote connectors for web and desktop chat: OAuth, token storage and MCP calls.'
    }
  }

  entra = externalSystem 'Microsoft Entra ID' {
    #existing
    description 'Existing single-tenant registration. Unchanged by ADR-015.'
  }

  shadow = system 'Shadow' {
    #existing
    description 'Organisation twin modelling, metrics and forecasting. Since ADR-015: OAuth 2.1 authorization server and MCP server for AI clients.'

    spa = webapp 'React SPA' {
      #existing
      technology 'React, TypeScript, Vite'
      description 'Workspace UI. Since ADR-015: consent page /ai/authorize and Metrics tab AI panel for change-set review.'
    }

    caddy = container 'Caddy ingress' {
      #existing
      technology 'Caddy'
      description 'Only public ingress. Serves the SPA and proxies /api. Since ADR-015: also proxies /.well-known/oauth-*; redacts Authorization and pending request ids in logs.'
    }

    backend = container 'Backend API' {
      #existing
      technology 'Python, FastAPI, SQLAlchemy'
      description 'Trusted application layer. Hosts the REST API and session login. Since ADR-015: the OAuth authorization server and the MCP service in the same process.'

      restApi = component 'REST business API' {
        #existing
        technology 'FastAPI /api/v1'
        description 'Existing routers for organisations, scenarios, structure, metrics and predictions.'
      }
      authSession = component 'Session auth and CSRF guard' {
        #existing
        technology 'OIDC RP, opaque sessions'
        description 'Entra login, guarded User linking, SameSite=Strict session, CSRF token and exact Origin.'
      }
      domainServices = component 'Domain services' {
        #existing
        technology 'Python services'
        description 'Organisation States and Twin Structure services. Since ADR-015: flush-only *_in_transaction cores (TASK-069B).'
      }
      oauthServer = component 'MCP OAuth authorization server' {
        #existing
        technology '/.well-known/oauth-*, /api/oauth/*'
        description 'Discovery, Dynamic Client Registration (allowlist), authorize, token (PKCE S256), refresh rotation, revoke. Opaque hashed tokens.'
      }
      consentApi = component 'Consent and connections API' {
        #existing
        technology '/api/v1/ai/oauth, /api/v1/ai/connections, /api/v1/ai/users/{user_id}/connections/revoke'
        description 'Approve or deny pending requests; list and revoke own grants; admin revokes all grants of a User. Session + CSRF.'
      }
      mcpAuth = component 'McpBearerAuth and limits' {
        #existing
        technology 'ASGI middleware'
        description 'Per request: hash token, check grant, resource /api/mcp and User, re-read role, intersect scopes, require shadow.read. Rate limit per grant for reads and writes together, capacity limiter.'
      }
      mcpService = component 'MCP service' {
        #existing
        technology 'FastMCP "Shadow", /api/mcp, shadow.read + shadow.write'
        description 'One endpoint and OAuth resource. Read tools and prompts need shadow.read; write tools need shadow.write and stage change sets, or apply and reject them when enabled. Tools outside the caller\'s scopes are hidden.'
      }
      changeSetEngine = component 'Change-set engine' {
        #existing
        technology 'Python'
        description 'Resolves $ref, dry-run with rollback, freezes values on submit, atomic apply.'
      }
      reviewApi = component 'Change-set review API' {
        #existing
        technology '/api/v1/organisations/{org}/ai/change-sets'
        description 'Human list, inspect, apply and reject in the Metrics tab. Session + CSRF.'
      }
      generator = component 'Timeseries generator' {
        #existing
        technology 'numpy'
        description 'Deterministic, seeded, spec-based values. The LLM chooses parameters, never values.'
      }
      skills = component 'Skills and MCP prompts' {
        #existing
        technology 'SKILL.md'
        description 'One source for the Claude Code plugin, skill zips (GET /api/v1/ai/skills/{name}.zip) and MCP prompts.'
      }
    }

    worker = container 'Prediction worker' {
      #existing
      technology 'Python, same backend image'
      description 'ADR-012 single worker. Not used or extended by MCP.'
    }

    db = database 'PostgreSQL 18' {
      #existing
      technology 'PostgreSQL'
      description 'Business tables. Since ADR-015: mcp_oauth_* and ai_change_sets*.'
    }
  }

  // People and clients
  user -> shadow.spa 'Uses Shadow, approves consent, reviews change sets' {
    technology 'HTTPS'
  }
  user -> aiClient 'Chats on own AI subscription'
  aiClient.webChat -> aiVendor.llm 'Prompts and tool results'
  aiClient.desktopApp -> aiVendor.llm 'Prompts and tool results'
  aiClient.localClient -> aiVendor.llm 'Prompts and tool results'
  aiClient.webChat -> aiVendor.broker 'Uses remote connector'
  aiClient.desktopApp -> aiVendor.broker 'Uses custom connector'
  aiVendor.broker -> shadow.caddy 'OAuth 2.1 and MCP' {
    technology 'HTTPS, Bearer token'
  }
  aiClient.localClient -> shadow.caddy 'OAuth 2.1 and MCP' {
    technology 'HTTPS, Bearer token'
  }

  // Ingress
  shadow.spa -> shadow.caddy 'Same-origin /api calls' {
    technology 'HTTPS, session cookie'
  }
  shadow.caddy -> shadow.backend.restApi 'Proxies /api/v1'
  shadow.caddy -> shadow.backend.consentApi 'Proxies /api/v1/ai'
  shadow.caddy -> shadow.backend.reviewApi 'Proxies /api/v1/.../ai/change-sets'
  shadow.caddy -> shadow.backend.oauthServer 'Proxies /.well-known/oauth-* and /api/oauth'
  shadow.caddy -> shadow.backend.mcpAuth 'Proxies /api/mcp'
  shadow.caddy -> shadow.backend.skills 'Skill zip download (session)'

  // Cookie-session side
  shadow.backend.restApi -> shadow.backend.authSession 'Requires session'
  shadow.backend.consentApi -> shadow.backend.authSession 'Requires session + CSRF'
  shadow.backend.reviewApi -> shadow.backend.authSession 'Requires session + CSRF'
  shadow.backend.skills -> shadow.backend.authSession 'Zip download requires session'
  shadow.backend.authSession -> entra 'OIDC login' {
    technology 'Authorization Code + PKCE'
  }
  shadow.backend.restApi -> shadow.backend.domainServices 'Calls'
  shadow.backend.consentApi -> shadow.backend.oauthServer 'Decides requests, revokes grants'
  shadow.backend.reviewApi -> shadow.backend.changeSetEngine 'Human apply or reject (web)'

  // MCP side
  shadow.backend.mcpAuth -> shadow.backend.oauthServer 'verify_access_token'
  shadow.backend.mcpAuth -> shadow.backend.mcpService 'Principal with effective scopes; each tool checks its own'
  shadow.backend.mcpService -> shadow.backend.domainServices 'Reads through existing services'
  shadow.backend.mcpService -> shadow.backend.generator 'Preview, persists nothing'
  shadow.backend.mcpService -> shadow.backend.skills 'Serves prompts'
  shadow.backend.mcpService -> shadow.backend.changeSetEngine 'Reads change sets and reviews; stage, dry-run, submit; apply or reject when enabled (mcp)'
  shadow.backend.changeSetEngine -> shadow.backend.generator 'Freezes values on submit'
  shadow.backend.changeSetEngine -> shadow.backend.domainServices 'Calls *_in_transaction cores'

  // Persistence
  shadow.backend.authSession -> shadow.db 'Users, identities, sessions'
  shadow.backend.oauthServer -> shadow.db 'mcp_oauth_* (hashes only)'
  shadow.backend.changeSetEngine -> shadow.db 'ai_change_sets, ai_change_set_operations'
  shadow.backend.domainServices -> shadow.db 'Business tables'
  shadow.worker -> shadow.db 'Prediction requests and versions (unchanged)'
}
