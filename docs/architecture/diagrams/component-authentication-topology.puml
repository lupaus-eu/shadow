@startuml
!include <C4/C4_Container>
title Shadow - Authentication Topology (Authentik, ADR-017 and ADR-0023; production Authentik planned, steps 086A-087B)

System_Ext(mail_prod, "Scaleway TEM", "Production transactional email\nAuthentik invitations and recovery")

System_Boundary(local, "Development - https://app.localhost") {
  Person(local_browser, "Local browser")
  Container(app_tls, "Application TLS", "Loopback Caddy :443", "Local CA; secure host-only cookies\nDirect /api routing; HMR WebSockets")
  Container(vite, "Frontend", "Vite :5173", "SPA and HMR")
  Container(id_tls, "Identity host", "Local Caddy", "https://id.app.localhost")
  Container(local_authentik, "Authentik (own instance)", "Authentik server + worker", "Web client 'Shadow'; MCP client 'Shadow MCP'\nPre-registered, PKCE required\nOwn logical database")
  Container(mailpit, "Mailpit", "Local only", "Catches Authentik mail")
  Container(local_api, "Local API", "FastAPI :8000", "OIDC via Authentik; development client\nGuarded pre-provisioned User linking\nShadow's own OAuth server still exists")
  Container(local_worker, "Prediction worker", "Backend runtime", "One worker; database settings only")
  ContainerDb(local_db, "Local database", "PostgreSQL", "Independent development data")

  Rel(local_browser, app_tls, "Uses", "HTTPS")
  Rel(app_tls, vite, "SPA / HMR", "HTTP / WebSocket")
  Rel(app_tls, local_api, "/api; fixed headers", "HTTP")
  Rel(local_api, local_db, "Users, identities, sessions")
  Rel(local_worker, local_db, "Queue + advisory lock")
  Rel(local_browser, id_tls, "Sign-in", "HTTPS")
  Rel(id_tls, local_authentik, "Proxies", "HTTP")
  Rel(local_authentik, local_db, "Own logical database")
  Rel(local_authentik, mailpit, "Mail", "SMTP")
  Rel(local_api, local_authentik, "Token and JWKS (OIDC_INTERNAL_BASE_URL)", "HTTP, Docker network")
}

System_Boundary(prod, "UpCloud Ubuntu 26.04 LTS - Docker Engine / Compose (runtime G; first rollout F)") {
  Person(prod_browser, "Production browser")
  Container(caddy, "Frontend and TLS", "Caddy :80 / :443 + React", "https://shadow.lupaus.eu\nPersistent certificate/account storage")
  Container(prod_id, "Authentik (own instance)", "Planned, steps 086A-087B", "https://id.shadow.lupaus.eu\nWeb client 'Shadow'; MCP client 'Shadow MCP'\nPKCE required; own logical database")
  Container(prod_api, "Production API", "FastAPI :8000", "OIDC via Authentik; production client\nPrivate; database roles and sessions\nShadow's own OAuth server still exists")
  Container(prod_worker, "Prediction worker", "Same backend image", "One worker; private; database settings only")
  Container(migration, "One-shot migration", "Same backend image", "Success gates API and worker startup")
  Container(ofelia, "Operational scheduler", "Ofelia; pinned digest", "Fixed read-only job file\nNo network or public ports\nDaily backups / weekly cleanup")
  Container(docker_api, "Host control plane", "Docker Engine Unix socket", "Host-administrator-equivalent authority\nSocket :ro does not restrict API writes")
  Container(ops_jobs, "Operational job runners", "Pre-created hardened Compose containers", "Backup: private DB access + required secrets\nWrites /opt/postgres-backups; 7-day retention\nCleanup: protected resources + exclusion locks")
  ContainerDb(prod_db, "Production database", "PostgreSQL 18 container", "Private; persistent volume\nMigration -> reference seed -> admin (explicit C/D commands)\nDaily encrypted on-server backups\n/opt/postgres-backups; host-loss risk\n7-day retention; backup + restore evidence gates")

  Rel(prod_browser, caddy, "Uses", "HTTPS")
  Rel(caddy, prod_api, "/api; fixed headers", "HTTP")
  Rel(prod_api, prod_db, "Users, identities, sessions")
  Rel(prod_worker, prod_db, "Queue + advisory lock")
  Rel(prod_browser, prod_id, "Sign-in", "HTTPS")
  Rel(prod_api, prod_id, "Token and JWKS (OIDC_INTERNAL_BASE_URL)", "HTTP, Docker network")
  Rel(prod_id, prod_db, "Own logical database")
  Rel(migration, prod_db, "Forward migrations")
  Rel(ofelia, docker_api, "Triggers reviewed jobs", "Local Unix socket")
  Rel(docker_api, ops_jobs, "Executes with verified restrictions")
  Rel(ops_jobs, prod_db, "Backup runner only", "Private database network")
}

Rel(prod_id, mail_prod, "Invitations, recovery", "SMTP")

note bottom of app_tls
  Each environment has its own Authentik instance (ADR-017).
  Local Authentik runs behind Caddy at https://id.app.localhost; mail goes to Mailpit.
  Production Authentik (https://id.shadow.lupaus.eu, Scaleway TEM) is planned.
  Browser authorization redirects go to the identity host.
  The backend reaches Authentik inside the Docker network.
  Backend verification of Shadow MCP tokens is a later step (080I).
end note

note bottom of caddy
  Caddy owns public TLS; no Traefik or Coolify in target.
  Coolify adapter removed; only Caddy publishes 80/443.
  Backend health gates frontend readiness.
  Build on UpCloud; deploy frozen images without rebuild.
  Persistent volumes are not backups.
  Backup tooling (G) and runbook QA (E) done; activated by F on 2026-10-02.
end note
@enduml
