@startuml
title AI-First Pull Request Workflow

start

:Idea / Requirement;
:Create GitHub Issue;

if (Small and clear change?) then (yes)
  :Use Issue as implementation spec;
else (no)
  :Create tasks/TASK-XXX.md;
  :Human approves scope;
endif

partition "Developer DEV Environment" {
  :Checkout main;
  :Pull latest main;
  :Create feature/fix/docs branch;
}

partition "AI Implementation" {
  :AI reads AGENTS.md;
  :AI reads ARCHITECTURE.md;
  :AI reads relevant ADRs;
  :AI reads Issue or TASK spec;
  :Implement scoped change;
  :Write or update tests;
  :Update docs if needed;
}

partition "Local Verification" {
  :Review diff locally;
  :Run lint/tests/build when available;
  :Fetch origin;
  :Rebase on origin/main;
}

:Push branch to GitHub;
:Open Pull Request;

partition "Continuous Integration" {
  :Install dependencies;
  :Lint;
  :Run tests;
  :Build project;
}

if (CI passed?) then (yes)
else (no)
  :Fix CI failures;
  :Push updates;
  :Re-run CI;
endif

partition "AI Review" {
  :Check acceptance criteria;
  :Check regressions;
  :Check security issues;
  :Check missing tests;
  :Check documentation updates;
}

if (AI review issues?) then (yes)
  :AI or developer fixes findings;
  :Push updates;
  :Re-run CI;
else (no)
endif

partition "Human Review" {
  :Review scope;
  :Review architecture;
  :Review database changes;
  :Review security;
  :Review maintainability;
}

if (Changes requested?) then (yes)
  :AI and/or developer updates PR;
  :Push changes;
  :Re-run CI;
  :Re-review;
else (approved)
  :Human approval;
  :Squash Merge;
  partition "Deployment" {
    :Deploy to staging/production when configured;
    :Run migrations when required;
    :Health checks;
  }
  :Close Issue;
  :Mark TASK complete if used;
  stop
endif

@enduml
