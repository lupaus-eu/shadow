DATABASE_NAME=schatten
DATABASE_USER=schatten
DATABASE_PASSWORD=schatten_dev_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Used by backend and migration commands that run directly on the host.
# Docker Compose derives its container URL from DATABASE_NAME/USER/PASSWORD.
DATABASE_URL=postgresql://schatten:schatten_dev_password@localhost:5432/schatten
APP_URL=https://app.localhost
FRONTEND_DEV_API_PROXY_TARGET=http://backend:8000

# Backend OIDC relying-party configuration. Copy private direct-Entra values to
# .env.entra.local with scripts/setup-local-entra.sh; never add them here.
APP_ENV=development
OIDC_SCOPES="openid profile email"
OIDC_CALLBACK_PATH=/api/v1/auth/callback
OIDC_ALLOWED_SIGNING_ALGORITHMS=RS256
OIDC_REQUIRE_VERIFIED_EMAIL=false
PUBLIC_ORIGIN=https://app.localhost
APP_ALLOWED_ORIGIN=https://app.localhost
TRUSTED_CADDY_PEER_CIDRS=172.28.59.2/32
SESSION_COOKIE_SECURE=true
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_SESSION_ABSOLUTE_LIFETIME_SECONDS=28800
AUTH_SESSION_ACTIVITY_WRITE_SECONDS=300
OIDC_TRANSACTION_LIFETIME_SECONDS=600
