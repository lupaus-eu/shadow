DATABASE_NAME=schatten
DATABASE_USER=schatten
DATABASE_PASSWORD=schatten_dev_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Used by backend and migration commands that run directly on the host.
# Docker Compose derives its container URL from DATABASE_NAME/USER/PASSWORD.
DATABASE_URL=postgresql://schatten:schatten_dev_password@localhost:5432/schatten
APP_URL=https://app.localhost
FRONTEND_DEV_API_PROXY_TARGET=http://backend:8000

# Backend OIDC relying-party configuration. Copy private direct-Entra values to
# .env.entra.local with scripts/setup-local-entra.sh; never add them here.
APP_ENV=development
OIDC_SCOPES="openid profile email"
OIDC_CALLBACK_PATH=/api/v1/auth/callback
OIDC_ALLOWED_SIGNING_ALGORITHMS=RS256
OIDC_REQUIRE_VERIFIED_EMAIL=false
PUBLIC_ORIGIN=https://app.localhost
APP_ALLOWED_ORIGIN=https://app.localhost
TRUSTED_CADDY_PEER_CIDRS=172.28.59.2/32
SESSION_COOKIE_SECURE=true
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_SESSION_ABSOLUTE_LIFETIME_SECONDS=28800
AUTH_SESSION_ACTIVITY_WRITE_SECONDS=300
OIDC_TRANSACTION_LIFETIME_SECONDS=600

# AI via MCP (ADR-015). Off by default; with false every MCP and MCP OAuth endpoint
# returns 404. Loopback entries keep the literal {port} placeholder.
MCP_ENABLED=false
# MCP clients can also apply and reject change sets (ADR-015 amendment, TASK-069O).
# No effect while MCP_ENABLED is false.
MCP_CHANGE_SET_REVIEW_ENABLED=false
MCP_OAUTH_REDIRECT_URIS="https://claude.ai/api/mcp/auth_callback https://claude.com/api/mcp/auth_callback http://127.0.0.1:{port}/callback http://[::1]:{port}/callback http://localhost:{port}/callback"
MCP_OAUTH_AUTHORIZATION_REQUEST_LIFETIME_SECONDS=600
MCP_OAUTH_AUTHORIZATION_CODE_LIFETIME_SECONDS=60
MCP_OAUTH_ACCESS_TOKEN_LIFETIME_SECONDS=3600
MCP_OAUTH_REFRESH_TOKEN_IDLE_LIFETIME_SECONDS=604800
MCP_OAUTH_GRANT_LIFETIME_SECONDS=2592000
MCP_OAUTH_REGISTER_RATE_LIMIT_PER_MINUTE=30
MCP_OAUTH_AUTHORIZE_RATE_LIMIT_PER_MINUTE=20
MCP_OAUTH_TOKEN_RATE_LIMIT_PER_MINUTE=300
MCP_OAUTH_REVOKE_RATE_LIMIT_PER_MINUTE=60
MCP_OAUTH_MAX_PENDING_REQUESTS_PER_CLIENT=20
MCP_OAUTH_MAX_PENDING_REQUESTS=1000
MCP_OAUTH_MAX_CLIENTS=10000
MCP_TOOL_CONCURRENCY=4
MCP_RATE_LIMIT_PER_MINUTE=120
AI_CHANGE_SET_STATEMENT_TIMEOUT_MS=30000
AI_CHANGE_SET_LOCK_TIMEOUT_MS=5000
