DATABASE_NAME=schatten
DATABASE_USER=schatten
DATABASE_PASSWORD=schatten_dev_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=postgresql://schatten:schatten_dev_password@localhost:5432/schatten
APP_URL=http://localhost:3000
FRONTEND_DEV_API_PROXY_TARGET=http://backend:8000

# Backend OIDC relying-party configuration. TASK-039E supplies local Authentik
# values; keep secrets out of this file and inject the real value at runtime.
APP_ENV=development
OIDC_DISCOVERY_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_CALLBACK_PATH=/api/v1/auth/callback
OIDC_ALLOWED_SIGNING_ALGORITHMS=RS256
OIDC_REQUIRE_VERIFIED_EMAIL=true
PUBLIC_ORIGIN=http://localhost:5173
APP_ALLOWED_ORIGIN=http://localhost:5173
TRUSTED_CADDY_PEER_CIDRS=
SESSION_COOKIE_SECURE=false
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_SESSION_ABSOLUTE_LIFETIME_SECONDS=28800
AUTH_SESSION_ACTIVITY_WRITE_SECONDS=300
OIDC_TRANSACTION_LIFETIME_SECONDS=600

# Add project-specific secrets only as empty examples.
# Never commit real secret values.
