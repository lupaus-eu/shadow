DATABASE_NAME=schatten
DATABASE_USER=schatten
DATABASE_PASSWORD=schatten_dev_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Used by backend and migration commands that run directly on the host.
# Docker Compose derives its container URL from DATABASE_NAME/USER/PASSWORD.
DATABASE_URL=postgresql://schatten:schatten_dev_password@localhost:5432/schatten
APP_URL=http://app.localhost:5173
FRONTEND_DEV_API_PROXY_TARGET=http://backend:8000

# Backend OIDC relying-party configuration. The defaults below match the local
# Authentik blueprint. Generate the client secret in .env.authentik.local with
# scripts/setup-local-authentik.sh; never add the real value here.
APP_ENV=development
OIDC_DISCOVERY_URL=https://auth.localhost:9443/application/o/schatten/.well-known/openid-configuration
OIDC_ISSUER=https://auth.localhost:9443/application/o/schatten/
OIDC_CLIENT_ID=schatten-local
# Used when the backend runs directly on the host.
OIDC_CLIENT_SECRET=
# Used by Docker Compose for both the backend and Authentik blueprint.
SCHATTEN_OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid profile email"
OIDC_CALLBACK_PATH=/api/v1/auth/callback
OIDC_ALLOWED_SIGNING_ALGORITHMS=RS256
OIDC_REQUIRE_VERIFIED_EMAIL=true
PUBLIC_ORIGIN=http://app.localhost:5173
APP_ALLOWED_ORIGIN=http://app.localhost:5173
TRUSTED_CADDY_PEER_CIDRS=
SESSION_COOKIE_SECURE=false
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_SESSION_ABSOLUTE_LIFETIME_SECONDS=28800
AUTH_SESSION_ACTIVITY_WRITE_SECONDS=300
OIDC_TRANSACTION_LIFETIME_SECONDS=600

# Add project-specific secrets only as empty examples.
# Never commit real secret values.
