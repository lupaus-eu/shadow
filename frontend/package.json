    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "diagram-js": "^15.28.1",
    "diagram-js-minimap": "^5.6.0",
