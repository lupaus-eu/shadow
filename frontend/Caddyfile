{
	admin off
	skip_install_trust
	servers {
		# Only TCP 80/443 are published; do not advertise HTTP/3 over UDP.
		protocols h1 h2
	}
}

# Production uses Caddy's default public ACME issuers. Disposable QA selects
# the internal issuer through CADDY_TLS_MODE=internal.
(tls_acme) {
	tls {
		issuer acme
	}
}

(tls_internal) {
	tls internal
}

# Loopback-only container health endpoint; independent of certificate issuance.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /health "OK" 200
	respond 404
}

# Requests for any other Host (after a valid TLS handshake, or over HTTP) are
# rejected explicitly instead of falling through to an empty response.
:443 {
	respond "Invalid host" 400
}

http:// {
	respond "Invalid host" 400
}

{$PUBLIC_HOST} {
	import tls_{$CADDY_TLS_MODE}

	log {
		output stdout
		format filter {
			request>headers>X-Csrf-Token replace REDACTED
			request>headers>Authorization replace REDACTED
			request>uri query {
				replace code REDACTED
				replace state REDACTED
				replace error REDACTED
				replace error_description REDACTED
				# Entra's login session identifier on the callback.
				replace session_state REDACTED
				# ADR-015: MCP OAuth pending request ids.
				replace request REDACTED
				replace return_to REDACTED
				# ADR-015: OAuth tokens and PKCE verifiers misplaced in a query.
				replace token REDACTED
				replace access_token REDACTED
				replace refresh_token REDACTED
				replace code_verifier REDACTED
			}
			# Authorization redirects carry request ids, codes and Entra state.
			resp_headers>Location replace REDACTED
			wrap json
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
	}

	route {
		@invalid_host not host {$PUBLIC_HOST}
		respond @invalid_host "Invalid host" 400

		@health path /health
		respond @health "OK" 200

		# Caddy is the TLS edge; the TCP peer is the client. Replace every
		# browser-supplied forwarding header with fixed values.
		@api path /api /api/* /.well-known/oauth-authorization-server* /.well-known/oauth-protected-resource*
		request_header @api -Forwarded
		request_header @api -X-Forwarded-*
		request_header @api -X-Shadow-Client-IP
		reverse_proxy @api backend:8000 {
			header_up Host {$PUBLIC_HOST}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Host {$PUBLIC_HOST}
			header_up X-Forwarded-Proto https
			header_up X-Shadow-Client-IP {remote_host}
		}

		root * /srv
		try_files {path} /index.html
		file_server
	}
}
