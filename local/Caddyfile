{
	auto_https off
}

:443 {
	tls /certs/app.localhost.crt /certs/app.localhost.key

	log {
		output stdout
		format filter {
			request>headers>X-Csrf-Token replace REDACTED
			request>headers>Authorization replace REDACTED
			request>uri query {
				replace code REDACTED
				replace state REDACTED
				replace error REDACTED
				replace error_description REDACTED
				# Entra's login session identifier on the callback.
				replace session_state REDACTED
				# ADR-015: MCP OAuth pending request ids.
				replace request REDACTED
				replace return_to REDACTED
				# ADR-015: OAuth tokens and PKCE verifiers misplaced in a query.
				replace token REDACTED
				replace access_token REDACTED
				replace refresh_token REDACTED
				replace code_verifier REDACTED
			}
			# Authorization redirects carry request ids, codes and Entra state.
			resp_headers>Location replace REDACTED
			wrap json
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# Allow only Vite's inline React-refresh preamble in development.
		# frontend/localCsp.test.ts checks this hash against the installed plugin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Z2/iFzh9VMlVkEOar1f/oSHWwQk3ve1qk/C2WdsC4Xk='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss://app.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
	}

	route {
		@invalid_host not host app.localhost
		respond @invalid_host "Invalid host" 400

		@health path /health
		respond @health "OK" 200

		@api path /api /api/* /.well-known/oauth-authorization-server* /.well-known/oauth-protected-resource*
		request_header @api -Forwarded
		request_header @api -X-Forwarded-*
		request_header @api -X-Shadow-Client-IP
		reverse_proxy @api backend:8000 {
			header_up Host app.localhost
			header_up X-Forwarded-Host app.localhost
			header_up X-Forwarded-Proto https
			header_up X-Shadow-Client-IP {remote_host}
		}

		reverse_proxy frontend:5173 {
			header_up Host app.localhost
		}
	}
}

# Identity (ADR-017): Authentik, reached by browsers only through this host. The
# application reaches it inside the Docker network (OIDC_INTERNAL_BASE_URL).
id.app.localhost:443 {
	tls /certs/app.localhost.crt /certs/app.localhost.key

	log {
		output stdout
		format filter {
			request>headers>Authorization replace REDACTED
			request>headers>Cookie replace REDACTED
			request>uri query {
				replace code REDACTED
				replace state REDACTED
				replace token REDACTED
				replace code_verifier REDACTED
				replace id_token_hint REDACTED
				# Invitation and email-verification tokens, also inside the flow executor's
				# URL-encoded `query` parameter.
				replace itoken REDACTED
				replace flow_token REDACTED
				replace query REDACTED
			}
			resp_headers>Location replace REDACTED
			resp_headers>Set-Cookie replace REDACTED
			wrap json
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		# Authentik pages need inline scripts and styles; this keeps the rest of the
		# policy that does not break them.
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
	}

	reverse_proxy authentik-server:9000 {
		# Replace Authentik's own values instead of adding a second one.
		header_down Referrer-Policy "no-referrer"
		header_down X-Content-Type-Options "nosniff"
	}
}
