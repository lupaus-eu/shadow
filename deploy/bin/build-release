#!/usr/bin/env bash
# Build matching frontend/backend images from one manifest-verified source
# folder accepted by schatten-receive and freeze them in a release record. The
# folder is copied into the release and that copy is re-verified against its
# manifest before building, so only listed, unchanged files enter the images.
# Uses no secrets and no Git.
#
# Usage: deploy/bin/build-release --source <verified source folder>
#   for example /opt/apps/schatten-sources/<commit>

source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
bin_dir="$(dirname "$(readlink -f "$0")")"

[[ $# == 2 && "$1" == --source ]] || die "Usage: build-release --source <verified source folder>"
[[ -d "$2" && ! -L "$2" ]] || die "Source folder $2 is missing or a symlink"
source_dir="$(cd "$2" && pwd -P)"
commit="$(basename "${source_dir}")"
[[ "${commit}" =~ ^[0-9a-f]{40}$ ]] || die "Source folder name must be the 40-character commit accepted by schatten-receive"

load_config
# Only folders accepted by schatten-receive: --verify checks a folder against
# its own manifest, not against the operator-supplied digest.
sources_dir="$(cd "${SCHATTEN_SOURCES_DIR}" 2>/dev/null && pwd -P)" \
  || die "Sources directory ${SCHATTEN_SOURCES_DIR} is missing; run deploy/bin/init-state"
[[ "$(dirname "${source_dir}")" == "${sources_dir}" ]] \
  || die "${source_dir} is not an accepted source under ${sources_dir}; receive it with schatten-receive first"
hold_release_lock
hold_maintenance_lock

release_id="$(date -u +%Y%m%dT%H%M%SZ)-${commit:0:12}"
final_dir="$(release_dir "${release_id}")"
work_dir="${final_dir}.incomplete"
[[ ! -e "${final_dir}" && ! -e "${work_dir}" ]] || die "Release ${release_id} already exists"
mkdir -p "${work_dir}/source"
# The copied source is read-only; make it removable again on failure.
trap 'chmod -R u+w "${work_dir}" 2>/dev/null || true; rm -rf "${work_dir}"' EXIT

tar -C "${source_dir}" -cf - . | tar -C "${work_dir}/source" -xf -
verified="$("${bin_dir}/schatten-receive" --verify "${work_dir}/source")" \
  || die "The release copy of ${source_dir} failed manifest verification"
manifest_value() {
  local value
  value="$(sed -n "s/^$1=//p" <<<"${verified}")"
  [[ -n "${value}" ]] || die "Manifest verification reported no $1"
  printf '%s' "${value}"
}
[[ "$(manifest_value SOURCE_COMMIT)" == "${commit}" ]] || die "Manifest SOURCE_COMMIT does not match ${source_dir}"
source_date_epoch="$(manifest_value SOURCE_DATE_EPOCH)"
source_ref="$(manifest_value SOURCE_REF)"
source_run_id="$(manifest_value SOURCE_RUN_ID)"
manifest_sha256="$(manifest_value SOURCE_MANIFEST_SHA256)"
# Build from 0644/0755 files as before the manifest path; frozen read-only below.
chmod -R u+w "${work_dir}/source"
backend_image="schatten-backend:${release_id}"
frontend_image="schatten-frontend:${release_id}"

started="$(date +%s)"
memory_before="$(awk '/^MemAvailable:/ { print $2 * 1024 }' /proc/meminfo)"
log "Building ${backend_image} and ${frontend_image} from ${commit} (manifest ${manifest_sha256})"
{
  docker buildx build --load --provenance=false --sbom=false \
    --build-arg SOURCE_DATE_EPOCH="${source_date_epoch}" \
    --target production --tag "${backend_image}" \
    --file "${work_dir}/source/backend/Dockerfile" "${work_dir}/source"
  docker buildx build --load --provenance=false --sbom=false \
    --build-arg SOURCE_DATE_EPOCH="${source_date_epoch}" \
    --target production --tag "${frontend_image}" \
    --file "${work_dir}/source/frontend/Dockerfile" "${work_dir}/source/frontend"
} 2>&1 | tee "${work_dir}/build.log" >&2
duration=$(( $(date +%s) - started ))

backend_id="$(docker image inspect --format '{{.Id}}' "${backend_image}")"
frontend_id="$(docker image inspect --format '{{.Id}}' "${frontend_image}")"
for image in "${backend_image}" "${frontend_image}"; do
  if docker image inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "${image}" \
    | grep -Eq '^(DATABASE_URL|POSTGRES_PASSWORD|OIDC_CLIENT_SECRET)='; then
    die "${image} contains a runtime secret variable in its image configuration"
  fi
done

{
  printf 'RELEASE_ID=%s\n' "${release_id}"
  printf 'SOURCE_COMMIT=%s\n' "${commit}"
  printf 'SOURCE_DATE_EPOCH=%s\n' "${source_date_epoch}"
  printf 'SOURCE_REF=%s\n' "${source_ref}"
  printf 'SOURCE_RUN_ID=%s\n' "${source_run_id}"
  printf 'SOURCE_MANIFEST_SHA256=%s\n' "${manifest_sha256}"
  printf 'BUILT_AT=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'BUILD_DURATION_SECONDS=%s\n' "${duration}"
  printf 'BUILD_MEMORY_AVAILABLE_BEFORE_BYTES=%s\n' "${memory_before}"
  printf 'BACKEND_IMAGE=%s\n' "${backend_image}"
  printf 'BACKEND_IMAGE_ID=%s\n' "${backend_id}"
  printf 'FRONTEND_IMAGE=%s\n' "${frontend_image}"
  printf 'FRONTEND_IMAGE_ID=%s\n' "${frontend_id}"
  printf 'DOCKER_ENGINE_VERSION=%s\n' "$(docker version --format '{{.Server.Version}}')"
  printf 'DOCKER_COMPOSE_VERSION=%s\n' "$(docker compose version --short)"
  printf 'DOCKER_BUILDX_VERSION=%s\n' "$(docker buildx version | awk '{ print $2 }')"
  printf 'KERNEL=%s\n' "$(uname -r)"
} >"${work_dir}/release.env"
chmod -R a-w "${work_dir}/source"
mv "${work_dir}" "${final_dir}"
trap - EXIT

log "Frozen release ${release_id} (build ${duration}s). Record: ${final_dir}/release.env"
cat "${final_dir}/release.env"
