#!/usr/bin/env bash
# Read-only audit of the existing, operator-reported cloud-init host baseline
# (TASK-059E) and the source-delivery setup (TASK-059H1/H3: upload account,
# upload-gate, AllowUsers, public-key-only SSH, upload and source folders), with
# SSH access as amended by TASK-059J (deploy and key-only root from any address).
# Separates effective state from the supplied configuration so F
# can record it. Uses `sudo -n` only for read-only inspection; never installs,
# reruns cloud-init, touches swap, reloads services or changes files.
#
# Output is sanitized: counts and settings only, never SSH keys, user-data,
# banned addresses, auth logs, environment files or secrets.
#   ok        matches the documented baseline
#   attention needs a recorded F decision or an authorized change
#   manual    must be checked outside this host (workstation, provider panel)
#   missing   could not be inspected (tool absent or no read permission)
#
# Usage: deploy/bin/audit-host   (or: make audit, from the verified source copy)

set -Eeuo pipefail

attention=0
missing=0
fact() { printf 'fact      %s\n' "$*"; }
ok() { printf 'ok        %s\n' "$*"; }
attn() { printf 'attention %s\n' "$*"; attention=$((attention + 1)); }
manual() { printf 'manual    %s\n' "$*"; }
miss() { printf 'missing   %s\n' "$*"; missing=$((missing + 1)); }
section() { printf '\n[%s]\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }
count_lines() { grep -c . || true; }
# Read-only privileged inspection; never prompts for a password.
priv() { if [[ "$(id -u)" == 0 ]]; then "$@"; else sudo -n "$@"; fi; }
unit() { local state; state="$(systemctl "$1" "$2" 2>/dev/null)" || true; printf '%s' "${state:-unknown}"; }

section os
# shellcheck disable=SC1091
. /etc/os-release
if [[ "${ID:-}" == ubuntu && "${VERSION_ID:-}" == 26.04 ]]; then ok "os ${PRETTY_NAME}"; else attn "os ${PRETTY_NAME:-unknown} is not the approved Ubuntu 26.04 LTS"; fi
fact "kernel $(uname -r)"
fact "coreutils $(stat --version 2>/dev/null | head -n 1)"
fact "sudo $(sudo --version 2>/dev/null | head -n 1 || printf 'absent')"
for tool in python3 curl gpg openssl flock ss make; do
  if have "${tool}"; then ok "tool ${tool}"; else attn "tool ${tool} is not installed"; fi
done
# Git is not used on the server (ADR-013); its presence is only recorded.
if have git; then fact "git $(git --version 2>/dev/null | awk '{ print $3 }') present (not used by Shadow)"; else fact "git absent (not needed)"; fi

section cloud-init
if have cloud-init && have python3; then
  set +e
  status_json="$(cloud-init status --format json 2>/dev/null)"
  status_code=$?
  set -e
  summary="$(python3 -c '
import json, sys
try:
    data = json.loads(sys.stdin.read() or "{}")
except ValueError:
    data = {}
recoverable = data.get("recoverable_errors") or {}
status = str(data.get("extended_status") or data.get("status") or "unknown")
print(status.replace(" ", "-"),
      len(data.get("errors") or []),
      sum(len(v) for v in recoverable.values()) if isinstance(recoverable, dict) else 0)
' <<<"${status_json}")"
  read -r cloud_status cloud_errors cloud_recoverable <<<"${summary}"
  if [[ "${cloud_status}" == "done" && "${cloud_errors}" == 0 && "${cloud_recoverable}" == 0 ]]; then
    ok "cloud-init status=${cloud_status} exit=${status_code} errors=0 recoverable=0"
  else
    attn "cloud-init status=${cloud_status} exit=${status_code} errors=${cloud_errors} recoverable=${cloud_recoverable}; inspect privately with: sudo cloud-init status --long"
  fi
else
  miss "cloud-init status (cloud-init or python3 absent)"
fi

section accounts
docker_members="$(getent group docker | cut -d: -f4 || true)"
fact "docker group members (host-administrator-equivalent): ${docker_members:-none}"
while IFS=: read -r name _ uid _ _ home shell; do
  [[ "${uid}" == 0 || ( "${uid}" -ge 1000 && "${uid}" -lt 60000 ) ]] || continue
  [[ "${shell}" == */nologin || "${shell}" == */false ]] && continue
  password="$(priv passwd -S "${name}" 2>/dev/null | awk '{ print $2 }' || true)"
  # Keys are counted, never printed.
  if key_lines="$(priv cat "${home}/.ssh/authorized_keys" 2>/dev/null)"; then
    keys="$(grep -Ev '^[[:space:]]*(#|$)' <<<"${key_lines}" | count_lines)" || true
  else
    keys=absent-or-unreadable
  fi
  groups="$(id -nG "${name}" 2>/dev/null | tr ' ' '\n' | grep -Ex 'sudo|docker|adm' | tr '\n' ',' || true)"
  fact "account ${name} uid=${uid} password=${password:-unknown} authorized_keys=${keys:-unknown} groups=${groups%,}"
  if [[ "${uid}" == 0 && "${keys}" =~ ^[0-9]+$ ]]; then
    # cloud-init disable_root: true prefixes root keys with a command that only
    # prints "Please login as the user ..." and disconnects.
    prefixed="$(grep -F 'Please login as the user' <<<"${key_lines}" | count_lines)" || true
    fact "account ${name} keys with cloud-init's disable_root prefix: ${prefixed} of ${keys} (such keys open no shell)"
  fi
  if [[ "${password}" == P || "${password}" == NP ]]; then
    attn "account ${name} has a usable or empty password (status ${password})"
  fi
done < /etc/passwd
if [[ "$(id -un)" == deploy ]]; then
  if sudo -n true 2>/dev/null; then fact "deploy has passwordless sudo (privileged operator)"; else fact "deploy has no passwordless sudo"; fi
fi
manual "from an operator workstation, open a fresh session: ssh -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no deploy@<host> true"
manual "confirm password login is refused: ssh -o PubkeyAuthentication=no -o PreferredAuthentications=password,keyboard-interactive deploy@<host> (expect Permission denied)"
manual "repeat the password refusal for root@<host>; a root key login by the root key holder is optional (TASK-059J)"

section ssh
# true only when password and keyboard-interactive login are off and root login
# is key-only or off; it decides whether SSH from Anywhere is the accepted
# ADR-013 exposure.
ssh_pubkey_only=unknown
if sshd_config="$(priv sshd -T 2>/dev/null)"; then
  for key in port listenaddress permitrootlogin passwordauthentication kbdinteractiveauthentication \
    pubkeyauthentication authenticationmethods permitemptypasswords usepam allowusers allowgroups maxauthtries; do
    value="$(awk -v k="${key}" '$1 == k { $1 = ""; sub(/^ /, ""); print }' <<<"${sshd_config}" | paste -sd, -)"
    fact "sshd ${key}=${value:-unset}"
  done
  root_login="$(awk '$1 == "permitrootlogin" { print $2 }' <<<"${sshd_config}")"
  # ADR-013 (TASK-059J): PermitRootLogin prohibit-password; sshd may print its
  # older alias without-password.
  case "${root_login}" in
    prohibit-password | without-password) ok "root SSH is key-only (permitrootlogin ${root_login}, ADR-013 TASK-059J)" ;;
    no) fact "root SSH login disabled (permitrootlogin no, stricter than ADR-013 TASK-059J requires)" ;;
    *) attn "sshd permitrootlogin=${root_login:-unset}: root SSH is not key-only (set PermitRootLogin prohibit-password, runbook 2.1)" ;;
  esac
  # shellcheck disable=SC2016 # awk program, not a shell expansion
  # Global settings only: everything after the first Match line is scoped.
  main_root_login="$(priv awk 'tolower($1) == "match" { exit } tolower($1) == "permitrootlogin" { print tolower($2); exit }' /etc/ssh/sshd_config 2>/dev/null)" || true
  [[ "${main_root_login}" == without-password ]] && main_root_login=prohibit-password
  if [[ -n "${main_root_login}" && "${main_root_login}" != "${root_login/without-password/prohibit-password}" ]]; then
    fact "/etc/ssh/sshd_config sets PermitRootLogin ${main_root_login} globally; the effective ${root_login:-unset} comes from an earlier drop-in"
  fi
  [[ "$(awk '$1 == "passwordauthentication" { print $2 }' <<<"${sshd_config}")" == no ]] && ok "SSH password authentication disabled" \
    || attn "SSH password authentication is enabled"
  [[ "$(awk '$1 == "kbdinteractiveauthentication" { print $2 }' <<<"${sshd_config}")" == no ]] && ok "SSH keyboard-interactive authentication disabled" \
    || attn "SSH keyboard-interactive authentication is enabled"
  if [[ "${root_login}" =~ ^(no|prohibit-password|without-password)$ \
    && "$(awk '$1 == "passwordauthentication" { print $2 }' <<<"${sshd_config}")" == no \
    && "$(awk '$1 == "kbdinteractiveauthentication" { print $2 }' <<<"${sshd_config}")" == no ]]; then
    ssh_pubkey_only=true
  else
    ssh_pubkey_only=false
  fi
  # ADR-013 (TASK-059J): AllowUsers deploy root shadow-upload; @<cidr>
  # patterns for deploy or root are an allowed, stricter choice.
  read -r -a allowed <<<"$(awk '$1 == "allowusers" { $1 = ""; print }' <<<"${sshd_config}" | tr '\n' ' ')"
  if (( ${#allowed[@]} == 0 )); then
    attn "AllowUsers is not set: every account with a key may log in (set AllowUsers deploy root shadow-upload, runbook 2.1)"
  else
    declare -A any_address=() restricted=()
    for pattern in "${allowed[@]}"; do
      case "${pattern}" in
        deploy | root | deploy@\* | root@\* | deploy@0.0.0.0/0 | root@0.0.0.0/0 | deploy@::/0 | root@::/0)
          any_address[${pattern%%@*}]=1 ;;
        deploy@* | root@*) restricted[${pattern%%@*}]=$(( ${restricted[${pattern%%@*}]:-0} + 1 )) ;;
        shadow-upload) ;;
        *) attn "AllowUsers also admits ${pattern}; only deploy, root and shadow-upload are expected (record or remove under F)" ;;
      esac
    done
    for account in deploy root; do
      if [[ -n "${any_address[${account}]:-}" ]]; then
        ok "AllowUsers admits ${account} from any address, public-key only (ADR-013 TASK-059J)"
      elif [[ -n "${restricted[${account}]:-}" ]]; then
        fact "AllowUsers admits ${account} only from ${restricted[${account}]} address pattern(s) (stricter than ADR-013 TASK-059J requires)"
      elif [[ "${account}" == deploy ]]; then
        attn "AllowUsers does not admit deploy; operators cannot log in"
      else
        fact "AllowUsers does not admit root: root SSH is shut out"
      fi
    done
    [[ " ${allowed[*]} " == *" shadow-upload "* ]] && ok "AllowUsers admits shadow-upload" \
      || attn "AllowUsers does not admit shadow-upload; the Deploy to production Action cannot upload"
  fi
  match_files="$(priv grep -rlis '^[[:space:]]*Match[[:space:]]' /etc/ssh/sshd_config /etc/ssh/sshd_config.d 2>/dev/null | count_lines)" || true
  [[ "${match_files}" == 0 ]] || attn "sshd has Match blocks in ${match_files} file(s); evaluate them with sshd -T -C user=...,host=...,addr=..."
else
  miss "effective sshd settings (needs sudo -n sshd -T)"
fi
for unit in ssh.socket ssh.service; do
  fact "${unit} $(unit is-active "${unit}")"
done

section firewall
if ufw_status="$(priv ufw status verbose 2>/dev/null)"; then
  while IFS= read -r line; do
    [[ -n "${line}" ]] && fact "ufw ${line}"
  done <<<"${ufw_status}"
  grep -q '^Status: active' <<<"${ufw_status}" && ok "ufw active" || attn "ufw is not active"
  # Verbose rules read, for example, `22/tcp (OpenSSH)  ALLOW IN  Anywhere`.
  if grep -Eq '^(22(/tcp)?|OpenSSH)([[:space:]]|$).*ALLOW IN[[:space:]]+Anywhere' <<<"${ufw_status}"; then
    # Accepted by ADR-013 for GitHub-hosted runners once SSH is public-key only.
    if [[ "${ssh_pubkey_only}" == true ]]; then
      fact "SSH is allowed from Anywhere (accepted: public-key only, root login key-only or disabled; AllowUsers is checked under [ssh])"
    else
      attn "SSH is allowed from Anywhere while password or keyboard-interactive login is enabled, root login is not key-only, or either is unverified; harden SSH first (runbook 2.1)"
    fi
  fi
else
  miss "ufw status (needs sudo -n ufw status verbose)"
fi
manual "check the UpCloud provider firewall for IPv4 and IPv6: TCP 22 from anywhere (IPv6 only if intended), TCP 80/443 public, nothing else"
fact "Docker publishes container ports through its own iptables chains; UFW rules alone do not make a published port private"

section listeners
if have ss; then
  while read -r proto address; do
    port="${address##*:}"
    host="${address%:*}"
    case "${host}" in
      127.*|\[::1\]|localhost|\[::ffff:127.*) fact "listener ${proto} ${address} (loopback)"; continue ;;
    esac
    fact "listener ${proto} ${address}"
    # UFW denies incoming UDP and nothing publishes UDP; TCP is the exposure check.
    case "${proto}/${port}" in
      tcp/22|tcp/80|tcp/443|udp/*) ;;
      tcp/2375|tcp/2376) attn "a Docker TCP API listener appears on ${address}; it must not exist" ;;
      *) attn "non-loopback TCP listener ${address} is not part of the baseline (22/80/443)" ;;
    esac
  done < <(ss -H -ltnu 2>/dev/null | awk '{ print $1, $5 }' | sort -u)
else
  miss "listening sockets (ss absent)"
fi

section docker
if server="$(docker version --format '{{.Server.Version}}' 2>/dev/null)"; then
  fact "docker engine ${server}"
  fact "docker components $(docker version --format '{{range .Server.Components}}{{.Name}}={{.Version}} {{end}}' 2>/dev/null)"
  fact "docker compose $(docker compose version --short 2>/dev/null || printf 'absent')"
  fact "docker buildx $(docker buildx version 2>/dev/null | awk '{ print $2 }' || printf 'absent')"
  fact "docker info $(docker info --format 'root={{.DockerRootDir}} storage={{.Driver}} cgroup={{.CgroupVersion}} live-restore={{.LiveRestoreEnabled}} security={{join .SecurityOptions ","}}' 2>/dev/null)"
  socket=/var/run/docker.sock
  fact "docker socket $(stat -c 'mode=%a owner=%U group=%G gid=%g' "${socket}" 2>/dev/null)"
  [[ "$(stat -c %a "${socket}" 2>/dev/null)" == 660 ]] && ok "docker socket mode 660" || attn "docker socket mode is not 660"
  if [[ -r /etc/docker/daemon.json ]]; then
    fact "daemon.json keys $(python3 -c 'import json, sys; print(",".join(sorted(json.load(sys.stdin))))' </etc/docker/daemon.json 2>/dev/null || printf 'unreadable')"
  else
    fact "daemon.json absent (Docker defaults, including the userland proxy for IPv6)"
  fi
  fact "containers running=$(docker ps --quiet | wc -l) all=$(docker ps --all --quiet | wc -l)"
  while IFS=$'\t' read -r name ports; do
    [[ -n "${ports}" ]] || continue
    fact "published ${name}: ${ports}"
    remaining="$(tr ',' '\n' <<<"${ports}" | grep -- '->' | grep -Ev ':(80|443)->(80|443)/tcp' || true)"
    [[ -z "${remaining}" ]] || attn "container ${name} publishes ports other than 80/443: ${remaining//$'\n'/ }"
  done < <(docker ps --format '{{.Names}}\t{{.Ports}}')
else
  miss "Docker Engine is not reachable by $(id -un)"
fi

section resources
if have swapon; then
  fact "swap $(swapon --show=NAME,TYPE,SIZE --noheadings 2>/dev/null | tr -s ' ' | paste -sd';' - || true)"
fi
fact "fstab swap entries $(awk '!/^[[:space:]]*#/ && $3 == "swap"' /etc/fstab 2>/dev/null | wc -l)"
swappiness="$(sysctl -n vm.swappiness 2>/dev/null || printf 'unknown')"
cache_pressure="$(sysctl -n vm.vfs_cache_pressure 2>/dev/null || printf 'unknown')"
[[ "${swappiness}" == 10 && "${cache_pressure}" == 50 ]] && ok "sysctl vm.swappiness=${swappiness} vm.vfs_cache_pressure=${cache_pressure}" \
  || attn "sysctl vm.swappiness=${swappiness} vm.vfs_cache_pressure=${cache_pressure} differ from the reported 10/50"
fact "cpus $(nproc)"
fact "$(free -m | awk '/^Mem:/ { print "memory total=" $2 "MiB available=" $7 "MiB" } /^Swap:/ { print "swap total=" $2 "MiB used=" $3 "MiB" }' | paste -sd' ' -)"
for path in / /var/lib/docker /opt; do
  [[ -e "${path}" ]] || continue
  fact "disk ${path} $(df -P -B1M "${path}" 2>/dev/null | awk 'NR == 2 { print "filesystem=" $1 " size=" $2 "MiB available=" $4 "MiB mount=" $6 }')"
done
fact "build resources are not inferred from swap; record build duration/memory from release.env"

section time
timezone="$(timedatectl show --property=Timezone --value 2>/dev/null || cat /etc/timezone 2>/dev/null || printf 'unknown')"
[[ "${timezone}" == Europe/Helsinki ]] && ok "timezone ${timezone}" || attn "timezone ${timezone} is not Europe/Helsinki"
fact "ntp synchronized=$(timedatectl show --property=NTPSynchronized --value 2>/dev/null || printf 'unknown')"

section fail2ban
fact "fail2ban service $(unit is-active fail2ban)"
if jail="$(priv fail2ban-client status sshd 2>/dev/null)"; then
  ok "fail2ban sshd jail present"
  fact "fail2ban sshd currently_banned=$(awk -F: '/Currently banned/ { gsub(/[[:space:]]/, "", $2); print $2 }' <<<"${jail}") total_banned=$(awk -F: '/Total banned/ { gsub(/[[:space:]]/, "", $2); print $2 }' <<<"${jail}")"
  settings=""
  for setting in maxretry findtime bantime; do
    settings+="${setting}=$(priv fail2ban-client get sshd "${setting}" 2>/dev/null | tr -d '[:space:]' || printf 'unknown') "
  done
  [[ "${settings}" == "maxretry=5 findtime=600 bantime=3600 " ]] && ok "fail2ban sshd ${settings% }" \
    || attn "fail2ban sshd ${settings% } differ from the reported 5/600/3600"
else
  attn "fail2ban sshd jail could not be read (needs sudo -n fail2ban-client status sshd)"
fi

section updates
fact "unattended-upgrades enabled=$(unit is-enabled unattended-upgrades) active=$(unit is-active unattended-upgrades)"
fact "apt-daily-upgrade.timer $(unit is-enabled apt-daily-upgrade.timer)"
if have apt-config; then
  for key in APT::Periodic::Update-Package-Lists APT::Periodic::Unattended-Upgrade \
    Unattended-Upgrade::Automatic-Reboot Unattended-Upgrade::Automatic-Reboot-Time \
    Unattended-Upgrade::Automatic-Reboot-WithUsers; do
    value="$(apt-config dump 2>/dev/null | awk -v k="${key}" '$1 == k { gsub(/[";]/, "", $2); print $2 }' | tail -n 1)"
    fact "apt ${key}=${value:-unset}"
  done
fi
[[ -e /var/run/reboot-required ]] && attn "a reboot is pending (/var/run/reboot-required); schedule it outside a release" || fact "no reboot pending"
held="$(apt-mark showhold 2>/dev/null | paste -sd, - || true)"
fact "held packages ${held:-none}"

section storage
for path in /opt/apps /opt/caddy /opt/postgres-backups /opt/apps/shadow /opt/apps/shadow-config \
  /opt/apps/shadow-state /opt/apps/shadow-releases /opt/apps/shadow-sources /opt/apps/shadow-upload; do
  if [[ ! -e "${path}" ]]; then
    fact "path ${path} absent"
    continue
  fi
  if listing="$(priv find "${path}" -mindepth 1 -maxdepth 1 2>/dev/null)"; then
    entries="$(count_lines <<<"${listing}")"
  else
    entries=unreadable
  fi
  fact "path ${path} $(stat -c 'owner=%u:%g(%U:%G) mode=%a' "${path}") entries=${entries} filesystem=$(df -P "${path}" 2>/dev/null | awk 'NR == 2 { print $1 }')"
done
# check-host and the setup steps write the Shadow paths as deploy; containers never write here.
for path in /opt/apps /opt/apps/shadow /opt/apps/shadow-config /opt/apps/shadow-state /opt/apps/shadow-releases \
  /opt/apps/shadow-sources; do
  [[ -e "${path}" ]] || continue
  owner="$(stat -c %U "${path}")"
  if [[ "${owner}" == deploy ]]; then
    ok "${path} owned by deploy"
  elif [[ "${path}" == /opt/apps ]]; then
    attn "${path} owner ${owner}; deploy must own it (F changes ownership non-recursively, runbook 2.2)"
  else
    attn "${path} owner ${owner}; deploy must own it (existing path: stop and review before setup, runbook 2.2)"
  fi
done
if [[ -d /opt/postgres-backups ]]; then
  backup_owner="$(stat -c %u:%g /opt/postgres-backups)"
  backup_mode="$(stat -c %a /opt/postgres-backups)"
  [[ "${backup_owner}" == 10002:10002 && "${backup_mode}" =~ ^7[05]0$ ]] && ok "/opt/postgres-backups owner ${backup_owner} mode ${backup_mode}" \
    || attn "/opt/postgres-backups owner ${backup_owner} mode ${backup_mode}; the backup runner needs 10002:10002 and 0700/0750 (F sets it, preserving contents)"
  if listing="$(priv find /opt/postgres-backups -maxdepth 1 -name 'shadow-*.manifest' 2>/dev/null)"; then
    fact "/opt/postgres-backups completed Shadow manifests=$(count_lines <<<"${listing}"); a directory alone is not backup evidence"
  else
    miss "/opt/postgres-backups contents (needs sudo -n find)"
  fi
fi
[[ -e /opt/apps/shadow ]] && fact "/opt/apps/shadow is the superseded Git checkout path; builds use /opt/apps/shadow-sources"

section upload
# root-owned and not group/other writable; $2 names the file in messages.
root_owned() {
  local facts uid owner mode
  facts="$(stat -c '%u %U %a' "$1")"
  read -r uid owner mode <<<"${facts}"
  [[ "${uid}" == 0 ]] && (( (8#${mode} & 8#022) == 0 )) && return 0
  attn "$1 (owner=${owner} mode=${mode}) must be root-owned and not group/other writable"
  return 1
}
upload_user=shadow-upload
if upload_entry="$(getent passwd "${upload_user}")"; then
  IFS=: read -r _ _ upload_uid _ _ upload_home upload_shell <<<"${upload_entry}"
  fact "account ${upload_user} uid=${upload_uid} home=${upload_home} shell=${upload_shell}"
  password="$(priv passwd -S "${upload_user}" 2>/dev/null | awk '{ print $2 }' || true)"
  [[ "${password}" == L ]] && ok "${upload_user} password locked" \
    || attn "${upload_user} password status ${password:-unknown} is not locked (L)"
  upload_groups="$(id -nG "${upload_user}" 2>/dev/null || true)"
  [[ "${upload_groups}" == "${upload_user}" ]] && ok "${upload_user} is only in its own group" \
    || attn "${upload_user} groups '${upload_groups}': it must be in its own group only (no sudo, docker, adm or deploy groups)"
  if sudo_rules="$(priv sudo -n -l -U "${upload_user}" 2>&1)"; then
    grep -qi 'may run' <<<"${sudo_rules}" && attn "${upload_user} has sudo rules" || ok "${upload_user} has no sudo rules"
  elif grep -qi 'not allowed' <<<"${sudo_rules}"; then
    ok "${upload_user} has no sudo rules"
  else
    miss "sudo rules of ${upload_user} (needs sudo -n -l -U)"
  fi
  id -nG deploy 2>/dev/null | tr ' ' '\n' | grep -qx "${upload_user}" && ok "deploy reads uploads through the ${upload_user} group" \
    || attn "deploy is not a member of the ${upload_user} group and cannot read uploads"
  keys_file="${upload_home}/.ssh/authorized_keys"
  for path in "${upload_home}" "${upload_home}/.ssh" "${keys_file}"; do
    if [[ -L "${path}" ]]; then
      attn "${path} is a symlink"
    elif [[ -e "${path}" ]]; then
      root_owned "${path}" && ok "${path} is root-owned; ${upload_user} cannot change its key restriction"
    fi
  done
  if key_lines="$(priv cat "${keys_file}" 2>/dev/null)"; then
    # Keys are counted, never printed.
    keys="$(grep -Ev '^[[:space:]]*(#|$)' <<<"${key_lines}" | count_lines)" || true
    gated="$(grep -Ec '^restrict,command="/usr/local/bin/upload-gate" (ssh-ed25519|ecdsa-sha2-nistp256|ssh-rsa) ' <<<"${key_lines}")" || true
    fact "${upload_user} authorized_keys=${keys} with restrict and upload-gate=${gated}"
    if [[ "${keys}" -ge 1 && "${keys}" == "${gated}" ]]; then
      ok "every ${upload_user} key has restrict and the upload-gate forced command"
    else
      attn "every ${upload_user} key must start with restrict,command=\"/usr/local/bin/upload-gate\" (${gated} of ${keys})"
    fi
  else
    attn "${keys_file} is missing or unreadable"
  fi
  if priv test -e "${upload_home}/.ssh/authorized_keys2"; then
    attn "${upload_home}/.ssh/authorized_keys2 exists; sshd also reads it by default"
  fi
else
  fact "account ${upload_user} absent (F creates it, runbook 2.2)"
fi
upload_dir=/opt/apps/shadow-upload
if [[ -L "${upload_dir}" ]]; then
  attn "${upload_dir} is a symlink"
elif [[ -d "${upload_dir}" ]]; then
  upload_dir_facts="$(stat -c '%U:%G %a' "${upload_dir}")"
  [[ "${upload_dir_facts}" == "${upload_user}:${upload_user} 750" ]] && ok "${upload_dir} ${upload_dir_facts}" \
    || attn "${upload_dir} is ${upload_dir_facts}; expected ${upload_user}:${upload_user} 750"
else
  fact "${upload_dir} absent (F creates it, runbook 2.2)"
fi

section source
for tool in /usr/local/bin/upload-gate /usr/local/bin/shadow-receive; do
  if [[ -L "${tool}" ]]; then
    attn "${tool} is a symlink; install the file itself root-owned"
  elif [[ -f "${tool}" ]]; then
    fact "${tool} $(stat -c 'owner=%U mode=%a' "${tool}") sha256=$(sha256sum <"${tool}" | cut -d' ' -f1)"
    root_owned "${tool}" && ok "${tool} is root-owned and not group/other writable"
  else
    fact "${tool} absent (F installs it root-owned before the first upload, runbook 2.2)"
  fi
done
if [[ -d /opt/apps/shadow-sources ]]; then
  shopt -s nullglob
  received=(/opt/apps/shadow-sources/*)
  shopt -u nullglob
  fact "received sources entries=${#received[@]} (newest 5 shown)"
  if (( ${#received[@]} > 0 )); then
    while read -r _ entry; do
      name="${entry##*/}"
      if [[ "${name}" =~ ^[0-9a-f]{40}$ ]]; then
        if [[ -f "${entry}/SOURCE_MANIFEST" && ! -L "${entry}/SOURCE_MANIFEST" ]]; then
          fact "received ${name} manifest=present sha256=$(sha256sum <"${entry}/SOURCE_MANIFEST" | cut -d' ' -f1)"
        else
          attn "received ${name} has no SOURCE_MANIFEST; it is not an accepted source"
        fi
      elif [[ "${name}" == *.incomplete ]]; then
        attn "staging ${name} was left by an interrupted receive; remove it once no receive runs"
      else
        attn "unexpected entry ${name} in /opt/apps/shadow-sources"
      fi
    done < <(stat -c '%Y %n' "${received[@]}" | sort -rn | head -n 5)
  fi
fi

printf '\nSUMMARY attention=%s missing=%s (record results under TASK-059F; this command changed nothing)\n' "${attention}" "${missing}"
