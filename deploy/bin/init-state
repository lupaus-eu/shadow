#!/usr/bin/env bash
# Create missing Shadow operator state under /opt/apps: release records,
# the verified source folder, deployment records, restore evidence and
# read-only lock files. Idempotent;
# never changes existing files, /opt/caddy or the backup directory.
#
# Usage: deploy/bin/init-state

source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
load_config

umask 022
for directory in "${SHADOW_RELEASES_DIR}" "${SHADOW_RELEASES_DIR}/retired" "${SHADOW_SOURCES_DIR}" \
  "${SHADOW_STATE_DIR}" "${SHADOW_LOCK_DIR}" "${SHADOW_STATE_DIR}/deployments"; do
  if [[ ! -d "${directory}" ]]; then
    mkdir -p "${directory}"
    log "Created ${directory}"
  fi
done
if [[ ! -d "${SHADOW_STATE_DIR}/restore-evidence" ]]; then
  mkdir -m 0700 "${SHADOW_STATE_DIR}/restore-evidence"
  log "Created ${SHADOW_STATE_DIR}/restore-evidence"
fi
# Runners open these read-only; flock needs no write access.
for lock in maintenance backup release; do
  if [[ ! -e "${SHADOW_LOCK_DIR}/${lock}.lock" ]]; then
    install -m 0644 /dev/null "${SHADOW_LOCK_DIR}/${lock}.lock"
    log "Created ${SHADOW_LOCK_DIR}/${lock}.lock"
  fi
done
log "Operator state is present. Backup directory ownership is verified, not changed: run deploy/bin/check-host."
