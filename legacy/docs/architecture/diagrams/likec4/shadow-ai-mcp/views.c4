// Shadow AI via MCP - views (ADR-015)
// Every element is implemented (#existing); colours follow the element kind.

views {

  view index {
    title 'Shadow AI via MCP - System Context (C4 L1)'
    description 'Implemented (TASK-069B..TASK-069P, TASK-074); MCP is enabled in production since 2026-11-03, and the one /api/mcp service of TASK-074 reaches production with its own approved release. The user chats in their own AI client; the AI reads Shadow and stages change sets through MCP; a human applies them in Shadow or approves the AI client\'s apply.'

    include
      user,
      aiClient,
      aiVendor,
      authentik,
      shadow
    include aiClient -> aiVendor with {
      title 'Prompts, tool calls and tool results'
    }
  }

  view shadowContainers of shadow {
    title 'Shadow AI via MCP - Containers (C4 L2)'
    description 'Implemented (TASK-069B..TASK-069P, TASK-074); MCP is enabled in production since 2026-11-03, and the one /api/mcp service of TASK-074 reaches production with its own approved release. MCP adds no container: the MCP service and the OAuth server run inside the existing backend.'

    include
      *,
      user,
      aiClient.*,
      aiVendor.*,
      authentik
    include shadow.caddy -> shadow.backend with {
      title 'Proxies /api, /.well-known/oauth-*'
    }
    include shadow.backend -> shadow.db with {
      title 'SQL: business, mcp_oauth_*, ai_change_sets*'
    }
  }

  view backendComponents of shadow.backend {
    title 'Shadow AI via MCP - Backend Components (C4 L3)'
    description 'Implemented (TASK-069B..TASK-069P, TASK-074); MCP is enabled in production since 2026-11-03, and the one /api/mcp service of TASK-074 reaches production with its own approved release. A change set is applied only by a human decision: the cookie-session review API in the Metrics tab, or the MCP service\'s apply_change_set behind MCP_CHANGE_SET_REVIEW_ENABLED, approved in the client. Each MCP tool checks its own scope.'

    include *
  }

  deployment view productionMcp {
    title 'Production MCP Deployment'
    description 'Implemented (TASK-069B..TASK-069P, TASK-074); MCP is enabled in production since 2026-11-03, and the one /api/mcp service of TASK-074 reaches production with its own approved release. https://shadow.lupaus.eu on the UpCloud host. Vendor-cloud connectors and local clients reach the same Caddy ingress.'

    include production.**
    // Deployment views ignore `with { title }` (LikeC4 1.60.0); show the
    // #edgeLabel deployment relations instead of the merged '[...]' edges.
    exclude production.upcloud.frontend.caddy -> production.upcloud.backend.backend where not tag is #edgeLabel
    exclude production.upcloud.backend.backend -> production.upcloud.database.db where not tag is #edgeLabel

    autoLayout LeftRight
  }

  deployment view developmentMcp {
    title 'Development MCP Deployment'
    description 'Implemented (TASK-069B..TASK-069P, TASK-074); MCP is enabled in production since 2026-11-03, and the one /api/mcp service of TASK-074 reaches production with its own approved release. https://app.localhost on loopback. Vendor-cloud connectors cannot reach localhost; test locally with Claude Code.'

    include development.**
    exclude development.devWorkstation.compose.localCaddy.localCaddyInstance -> development.devWorkstation.compose.devBackend.backend where not tag is #edgeLabel
    exclude development.devWorkstation.compose.devBackend.backend -> development.devWorkstation.compose.devDatabase.db where not tag is #edgeLabel
    exclude development.devVendor.broker -> development.devWorkstation.**
  }

  dynamic view connectFlow {
    title 'Connect An AI Client (OAuth 2.1 + Consent)'
    description 'Implemented (TASK-069B..TASK-069P, TASK-074); MCP is enabled in production since 2026-11-03, and the one /api/mcp service of TASK-074 reaches production with its own approved release. Shadow is the authorization server; the user signs in with the Authentik login (client Shadow) and approves consent in the SPA. Target state from SaaS plan step 080I: the AI client signs in through the Authentik provider Shadow MCP and the backend verifies its tokens (ADR-0023).'

    user -> aiClient.webChat 'Adds one connector URL /api/mcp'
    aiClient.webChat -> aiVendor.broker 'Register connector'
    aiVendor.broker -> shadow.backend.mcpAuth 'MCP request without token'
    shadow.backend.mcpAuth -> aiVendor.broker '401 + WWW-Authenticate resource_metadata'
    aiVendor.broker -> shadow.backend.oauthServer 'GET /.well-known/oauth-protected-resource and oauth-authorization-server'
    aiVendor.broker -> shadow.backend.oauthServer 'POST /api/oauth/register (allowlisted redirect URI)'
    user -> shadow.backend.oauthServer 'Browser: GET /api/oauth/authorize (PKCE S256, scope, resource)'
    shadow.backend.oauthServer -> shadow.spa '303 to /ai/authorize?request=<id> (stored hashed, 10 min)'
    shadow.spa -> shadow.backend.authSession 'If anonymous: existing login with return_to'
    shadow.backend.authSession -> authentik 'Authentik OIDC login'
    shadow.spa -> shadow.backend.consentApi 'GET request (scopes narrowed to the role); POST approve with CSRF + Origin'
    shadow.backend.consentApi -> shadow.backend.oauthServer 'Record User, issue 60 s one-time code (hashed)'
    shadow.spa -> aiVendor.broker 'Navigate to server-built redirectUrl (code, state, iss)'
    aiVendor.broker -> shadow.backend.oauthServer 'POST /api/oauth/token (code + PKCE verifier)'
    shadow.backend.oauthServer -> aiVendor.broker 'One grant: opaque access token (1 h) + rotating refresh token, effective scopes'
    aiVendor.broker -> shadow.backend.mcpAuth 'MCP calls with Bearer token'
  }

  dynamic view generateFlow {
    title 'Generate A Model And Timeseries (Human-Applied Change Set)'
    description 'Implemented (TASK-069B..TASK-069P, TASK-074); MCP is enabled in production since 2026-11-03, and the one /api/mcp service of TASK-074 reaches production with its own approved release. The LLM picks generator parameters, never values. Write tools stage; a human applies in the Metrics tab here, or in the AI client (see reviewInChatFlow).'

    autoLayout TopBottom

    user -> aiClient.webChat 'Asks for a model with monthly revenue for three years'
    aiClient.webChat -> aiVendor.llm 'Prompt + MCP tool definitions'
    aiVendor.llm -> aiVendor.broker 'Tool calls'
    aiVendor.broker -> shadow.backend.mcpAuth 'Bearer token checked on every call'
    shadow.backend.mcpAuth -> shadow.backend.mcpService 'get_type_catalog, get_graph, list_timeseries (shadow.read)'
    shadow.backend.mcpService -> shadow.backend.generator 'preview_generated_timeserie (persists nothing)'
    shadow.backend.mcpAuth -> shadow.backend.mcpService 'create_change_set, add_operations with $ref (shadow.write)'
    shadow.backend.mcpService -> shadow.backend.changeSetEngine 'validate_change_set: dry-run'
    shadow.backend.changeSetEngine -> shadow.backend.domainServices '*_in_transaction cores, always rolled back'
    shadow.backend.mcpService -> shadow.backend.changeSetEngine 'submit_change_set: re-validate'
    shadow.backend.changeSetEngine -> shadow.backend.generator 'Generate values from stored specs'
    shadow.backend.changeSetEngine -> shadow.db 'Store submitted change set with frozen values (ai_change_sets*)'
    aiClient.webChat -> user 'Review URL /shadow/<org>/metrics?changeSet=<key>'
    user -> shadow.spa 'Reviews change set in the Metrics AI panel'
    shadow.spa -> shadow.backend.reviewApi 'POST apply (session + CSRF + Origin)'
    shadow.backend.reviewApi -> shadow.backend.changeSetEngine 'Lock, check reviewFingerprint, re-validate, apply'
    shadow.backend.changeSetEngine -> shadow.backend.domainServices 'Same cores, one transaction'
    shadow.backend.domainServices -> shadow.db 'Commit once'
  }

  dynamic view reviewInChatFlow {
    title 'Apply A Change Set From The AI Client (MCP Change-Set Review)'
    description 'ADR-015 amendment of 2026-10-29 (TASK-069O), implemented; on the one MCP service since TASK-074. Only with MCP_CHANGE_SET_REVIEW_ENABLED. The AI shows the review and acts only on the user\'s explicit decision; the client asks the user to approve the call.'

    autoLayout TopBottom

    user -> aiClient.localClient 'Asks to review the staged change set'
    aiClient.localClient -> aiVendor.llm 'Prompt + MCP tool definitions'
    aiClient.localClient -> shadow.backend.mcpAuth 'get_change_set_review (Bearer)'
    shadow.backend.mcpAuth -> shadow.backend.mcpService 'Read tool, needs shadow.read'
    shadow.backend.mcpService -> shadow.backend.changeSetEngine 'Recompute replacements and review_fingerprint'
    aiClient.localClient -> user 'Shows operations and replaced data, asks for a decision'
    user -> aiClient.localClient 'Tells it to apply, approves the apply_change_set call'
    aiClient.localClient -> shadow.backend.mcpAuth 'apply_change_set with review_fingerprint (same Bearer token)'
    shadow.backend.mcpAuth -> shadow.backend.mcpService 'Write tool, needs shadow.write; registered only with the switch on'
    shadow.backend.mcpService -> shadow.backend.changeSetEngine 'Lock, check fingerprint, re-validate, apply; reviewed_via mcp'
    shadow.backend.changeSetEngine -> shadow.backend.domainServices 'Same cores, one transaction'
    shadow.backend.domainServices -> shadow.db 'Commit once'
  }
}
