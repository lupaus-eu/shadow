#!/usr/bin/env bash
# Restore a completed encrypted backup into a disposable, network-isolated
# PostgreSQL 18 container and verify schema/data. Never touches the production
# database. Writes sanitized evidence under <state>/restore-evidence.
#
# Usage: deploy/bin/restore-rehearsal <backup-id> --private-key <file> [--passphrase-file <file>]
#   The private key must be held separately from the backup directory. It and
#   the passphrase are streamed to the runner on stdin, never bind-mounted.

source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

backup_id="${1:-}"
shift || true
private_key=""
passphrase_file=""
while (( $# > 0 )); do
  case "$1" in
    --private-key) private_key="${2:-}"; shift 2 ;;
    --passphrase-file) passphrase_file="${2:-}"; shift 2 ;;
    *) die "Usage: restore-rehearsal <backup-id> --private-key <file> [--passphrase-file <file>]" ;;
  esac
done
[[ "${backup_id}" =~ ^shadow-[0-9]{8}T[0-9]{6}Z-[a-z-]+-[0-9a-f]{6}$ ]] || die "Invalid backup ID"
[[ -n "${private_key}" && -r "${private_key}" ]] || die "--private-key must name a readable file"
private_key="$(readlink -f "${private_key}")"
if [[ -n "${passphrase_file}" ]]; then
  [[ -r "${passphrase_file}" ]] || die "--passphrase-file must name a readable file"
  passphrase_file="$(readlink -f "${passphrase_file}")"
fi

load_config
hold_maintenance_lock
case "${private_key}" in
  "$(readlink -f "${SHADOW_BACKUP_DIR}")"/*) die "The private key must not be stored in the backup directory" ;;
esac

postgres_image="$(grep -Eo 'docker.io/library/postgres:[^ ]+@sha256:[0-9a-f]{64}' \
  "$(dirname "$(readlink -f "$0")")/../../docker-compose.production.yml" | head -n 1)"
suffix="$(date -u +%Y%m%dT%H%M%SZ)-$$"
network="shadow-restore-${suffix}"
target="shadow-restore-db-${suffix}"
password="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
evidence="${SHADOW_STATE_DIR}/restore-evidence/${suffix}-${backup_id}.txt"

cleanup() {
  docker rm --force --volumes "${target}" >/dev/null 2>&1 || true
  docker network rm "${network}" >/dev/null 2>&1 || true
}
trap cleanup EXIT

hardening=(--read-only --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 256)
docker network create --internal "${network}" >/dev/null
docker run --detach --name "${target}" --network "${network}" "${hardening[@]}" \
  --user 999:999 --tmpfs /var/run/postgresql:uid=999,gid=999,size=1m --tmpfs /tmp:size=64m \
  --mount type=volume,target=/var/lib/postgresql \
  --env POSTGRES_DB=restore_check --env POSTGRES_USER=restore_check --env POSTGRES_PASSWORD="${password}" \
  --label eu.lupaus.shadow.disposable=restore \
  "${postgres_image}" >/dev/null

key_material() {
  tar --create --file - --directory "$(dirname "${private_key}")" \
    --transform 's|.*|backup-private-key.asc|' "$(basename "${private_key}")"
  if [[ -n "${passphrase_file}" ]]; then
    tar --create --file - --directory "$(dirname "${passphrase_file}")" \
      --transform 's|.*|backup-key-passphrase|' "$(basename "${passphrase_file}")"
  fi
}

# The runner uses the backup user so it can read the 0600 backups through a
# read-only directory mount; the operator needs no direct read access.
set +e
output="$(key_material | docker run --rm --interactive --network "${network}" "${hardening[@]}" \
  --user "${SHADOW_BACKUP_UID}:${SHADOW_BACKUP_GID}" --tmpfs /tmp:mode=1777,size=64m \
  --env HOME=/tmp --env RESTORE_BACKUP_ID="${backup_id}" --env PGHOST="${target}" \
  --env PGUSER=restore_check --env PGPASSWORD="${password}" --env PGDATABASE=restore_check \
  --mount "type=bind,source=${SHADOW_BACKUP_DIR},target=/backups,readonly" \
  --mount "type=bind,source=$(dirname "$(readlink -f "$0")")/../ops,target=/opt/shadow-ops,readonly" \
  --entrypoint /opt/shadow-ops/restore-check.sh "${postgres_image}" 2>&1)"
status=$?
set -e
printf '%s\n' "${output}" >&2

umask 077
{
  printf 'RESTORE_REHEARSAL_AT=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'BACKUP_ID=%s\n' "${backup_id}"
  printf 'TARGET=disposable network-isolated %s\n' "${postgres_image}"
  if [[ "${status}" -eq 0 ]] && grep -q ' status=success ' <<<"${output}"; then
    printf 'STATUS=success\n'
  else
    printf 'STATUS=failed\n'
  fi
  printf '%s\n' "${output}" | grep -E ' (check|rows|status)=?' | sed 's/^/LOG /'
} >"${evidence}"
if ! grep -qx 'STATUS=success' "${evidence}"; then
  die "Restore rehearsal failed; evidence: ${evidence}"
fi
log "Restore rehearsal succeeded; evidence: ${evidence}"
printf 'RESTORE_EVIDENCE=%s\n' "${evidence}"
