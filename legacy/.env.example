DATABASE_NAME=shadow
DATABASE_USER=shadow
DATABASE_PASSWORD=shadow_dev_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Connection pool of each backend or worker process.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# Platform worker (background jobs, email outbox): seconds between scheduler
# runs, and after which an unfinished queue claim is taken again.
WORKER_SCHEDULE_INTERVAL_SECONDS=3600
QUEUE_CLAIM_TIMEOUT_SECONDS=900
# Notifications: days kept, and the email limit per recipient per day.
NOTIFICATION_RETENTION_DAYS=90
# Days a finished email (address and text) stays in the outbox.
OUTBOX_RETENTION_DAYS=7
NOTIFICATION_EMAILS_PER_DAY=10
# Local email is caught by Mailpit (web UI port below, loopback only).
MAILPIT_UI_PORT=8025
# Email backend of the worker outside Compose: log, smtp or scaleway. Compose sets
# smtp (Mailpit) locally; production uses scaleway with these (secrets live only
# in the protected production env file, never here):
#   EMAIL_BACKEND=scaleway
#   SCW_SECRET_KEY=  SCW_DEFAULT_PROJECT_ID=  SCW_TEM_DEFAULT_SENDER_EMAIL=
#   SCW_TEM_DEFAULT_SENDER_NAME=Shadow  SCW_TEM_REGION=fr-par
EMAIL_BACKEND=log
# Used by backend and migration commands that run directly on the host.
# Docker Compose derives its container URL from DATABASE_NAME/USER/PASSWORD.
DATABASE_URL=postgresql://shadow:shadow_dev_password@localhost:5432/shadow
APP_URL=https://app.localhost
FRONTEND_DEV_API_PROXY_TARGET=http://backend:8000

# Backend OIDC relying-party configuration. The local issuer, client and internal address
# (Authentik, ADR-017) are set in docker-compose.yml; outside Compose the backend reads
# OIDC_DISCOVERY_URL, OIDC_ISSUER (https://id.app.localhost/application/o/shadow/),
# OIDC_INTERNAL_BASE_URL, OIDC_CLIENT_ID and OIDC_CLIENT_SECRET.
APP_ENV=development
OIDC_SCOPES="openid profile email"
OIDC_CALLBACK_PATH=/api/v1/auth/callback
OIDC_ALLOWED_SIGNING_ALGORITHMS=RS256
OIDC_REQUIRE_VERIFIED_EMAIL=true
PUBLIC_ORIGIN=https://app.localhost
APP_ALLOWED_ORIGIN=https://app.localhost
TRUSTED_CADDY_PEER_CIDRS=172.28.59.2/32
SESSION_COOKIE_SECURE=true
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_SESSION_ABSOLUTE_LIFETIME_SECONDS=28800
AUTH_SESSION_ACTIVITY_WRITE_SECONDS=300
OIDC_TRANSACTION_LIFETIME_SECONDS=600

# AI via MCP (ADR-015). Off by default; with false every MCP and MCP OAuth endpoint
# returns 404. Loopback entries keep the literal {port} placeholder.
MCP_ENABLED=false
# MCP clients can also apply and reject change sets (ADR-015 amendment, TASK-069O).
# No effect while MCP_ENABLED is false.
MCP_CHANGE_SET_REVIEW_ENABLED=false
MCP_OAUTH_REDIRECT_URIS="https://claude.ai/api/mcp/auth_callback https://claude.com/api/mcp/auth_callback http://localhost:{port}/callback"
MCP_OAUTH_AUTHORIZATION_REQUEST_LIFETIME_SECONDS=600
MCP_OAUTH_AUTHORIZATION_CODE_LIFETIME_SECONDS=60
MCP_OAUTH_ACCESS_TOKEN_LIFETIME_SECONDS=3600
MCP_OAUTH_REFRESH_TOKEN_IDLE_LIFETIME_SECONDS=604800
MCP_OAUTH_GRANT_LIFETIME_SECONDS=2592000
MCP_OAUTH_REGISTER_RATE_LIMIT_PER_MINUTE=30
MCP_OAUTH_AUTHORIZE_RATE_LIMIT_PER_MINUTE=20
MCP_OAUTH_TOKEN_RATE_LIMIT_PER_MINUTE=300
MCP_OAUTH_REVOKE_RATE_LIMIT_PER_MINUTE=60
MCP_OAUTH_MAX_PENDING_REQUESTS_PER_CLIENT=20
MCP_OAUTH_MAX_PENDING_REQUESTS=1000
MCP_OAUTH_MAX_CLIENTS=10000
MCP_TOOL_CONCURRENCY=4
MCP_RATE_LIMIT_PER_MINUTE=120
AI_CHANGE_SET_STATEMENT_TIMEOUT_MS=30000
AI_CHANGE_SET_LOCK_TIMEOUT_MS=5000

# Identity (ADR-017): Authentik, behind local Caddy at https://id.app.localhost.
# Local development values only; production values live in the protected env file.
AUTHENTIK_VERSION=2026.8.5
AUTHENTIK_BASE_URL=https://id.app.localhost
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=authentik_dev_password
AUTHENTIK_SECRET_KEY=local-development-secret-change-me
AUTHENTIK_BOOTSTRAP_PASSWORD=local-admin-change-me
AUTHENTIK_BOOTSTRAP_TOKEN=local-bootstrap-token-change-me
# false: enrollment needs an invitation (production default); true: open (local default).
AUTHENTIK_ENROLLMENT_OPEN=true
# Password of the seeded development users admin@example.local and consultant@example.local
# (their TOTP secret is in authentik/dev/shadow-dev-users.yaml). Development only.
AUTHENTIK_DEV_USER_PASSWORD=shadow_dev_password
# The web OIDC client of the backend, as the blueprint registers it in Authentik (the
# LOCAL_ names keep it apart from the OIDC_* values the backend itself reads).
LOCAL_OIDC_CLIENT_ID=shadow-local
LOCAL_OIDC_CLIENT_SECRET=replace-with-a-random-oidc-secret
LOCAL_OIDC_REDIRECT_URI=https://app.localhost/api/v1/auth/callback
FRONTEND_URL=https://app.localhost
# The MCP client of AI tools (ADR-0023): a confidential, pre-registered client.
MCP_OIDC_CLIENT_ID=shadow-mcp-local
MCP_OIDC_CLIENT_SECRET=replace-with-a-random-mcp-secret
# The issuer of the MCP provider: the audience is the client id above, the issuer is this.
# Read by the backend from step 3b of the SaaS plan; the application slug is `shadow-mcp`.
MCP_OIDC_ISSUER=https://id.app.localhost/application/o/shadow-mcp/
